	column FiltroYTD = ```
			
			var oggi = TODAY()
			var inizio_anno_corrente = DATE(YEAR(oggi),1,1)
			var data_cella = 'Calendario'[DateJoin]
			RETURN
			IF(data_cella >= inizio_anno_corrente && data_cella <= oggi, 
			    "YTD",
			    "ALTRO")
			```
		lineageTag: 141097a5-7f64-46d2-9450-89f472bc4e0e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2024,12,31), MAX(Inspection[planning_date])),  // intervallo anni
				    "Anno", YEAR([Date]),
				    "Mese", FORMAT([Date], "MMMM"),
				    "NumeroMese", MONTH([Date]),
				    "Settimana", WEEKNUM([Date], 2),
				    "Giorno", DAY([Date]),  
				    "AnnoMese", FORMAT([Date], "YYYY-MM"),
				    "AnnoSettimana", YEAR([Date]) & "-" & WEEKNUM([Date], 2)
				)
				```

	annotation PBI_Id = 53296f8f0dfb46389389dd1b51244d4e

