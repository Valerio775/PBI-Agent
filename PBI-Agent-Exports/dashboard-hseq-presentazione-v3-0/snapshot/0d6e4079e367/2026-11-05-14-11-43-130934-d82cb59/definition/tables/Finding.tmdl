table Finding
	lineageTag: 45c998f3-c873-4131-8189-cdfa5a9ce36a

	measure 'Totale NCO' = ```
			
			var verifica = 
			CALCULATE(
			    COUNTROWS(Finding),
			    Finding[id_finding_type] = "FT_NCO" )
			RETURN if (ISBLANK(verifica), 0, verifica)
			```
		formatString: 0
		lineageTag: da62bba8-400a-4644-9d2a-ab653170b973

	measure 'NC Rate (%)' = ```
			
			var verifica = 
			DIVIDE(
			    [Ispezioni con NC],
			    [Totale Ispezioni]
			)
			RETURN if(ISBLANK(verifica), 0, verifica)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d6a33ee7-2d18-4c40-8e93-9e69f711b172

	measure 'Totale NC' = ```
			
			VAR Conteggio =
			    CALCULATE(
			        COUNTROWS(Finding),
			        Finding[id_finding_type] = "FT_NCO"
			    )
			RETURN IF(ISBLANK(Conteggio), 0, Conteggio)
			
			```
		formatString: 0
		lineageTag: a5736d12-1e59-4895-9056-7cd4ced8ba6d

	measure 'Conteggio di id_finding_type per FT_NCO' =
			
			CALCULATE(
				COUNT('Finding'[id_question]),
				'Finding'[id_finding_type] IN { "FT_NCO" }
			)
		formatString: 0
		lineageTag: 5a5dcc7a-b783-449e-bce9-f151b8e8f246

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'Ispezioni con NC' =
			
			VAR _IspezioniNelContesto = VALUES(Inspection[id])
			RETURN
			CALCULATE(
			    COUNT(Finding[id_inspection]), // DISTINCTCOUNT
			    FILTER(
			        Finding,
			        Finding[id_finding_type] = "FT_NCO" &&
			        Finding[id_inspection] IN _IspezioniNelContesto
			    )
			)
		formatString: 0
		lineageTag: 0cf3fa59-ee0e-4779-9d81-987f22c7eef9

	measure 'Totale NCO Cluster' =
			
			CALCULATE(
			    COUNTROWS(Finding),
			    Finding[id_finding_type] = "FT_NCO",
			    TREATAS(VALUES(Question[id]), Finding[id_question])
			)
		formatString: 0
		lineageTag: 23bb5e96-4f17-42f7-9bb6-61d0d70ee346

	measure 'Tooltip solo linea' =
			
			IF (
			    HASONEVALUE ( 'Inspection'[Formatted_scope] ),
			    BLANK (),
			    [Totale NCO]
			)
		formatString: 0
		lineageTag: ec92772e-de7b-4c7f-a1f8-9b768760fd27

	measure 'Detection rate' = DIVIDE([Totale NCO], Inspection[Totale Ispezioni])
		lineageTag: 15052dc6-60d2-4809-bf62-65e476a9e627

		annotation PBI_FormatHint = {"isGeneralNumber":true}

