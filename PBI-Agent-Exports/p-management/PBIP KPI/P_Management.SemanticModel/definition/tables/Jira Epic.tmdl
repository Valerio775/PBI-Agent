		lineageTag: a9bd97c0-5922-4da5-8950-4dd73f400a50
		sourceLineageTag: 5bb14130-25d5-4a43-af9d-6c348a480f6a
		dataCategory: Uncategorized

	measure 'SP Chiusi per Epic' = EXTERNALMEASURE("SP Chiusi per Epic", DOUBLE, "DirectQuery in Analysis Services - SpringLab")
		lineageTag: 75041a97-eeac-41d1-b235-60d1cb930459
		sourceLineageTag: 2deeb590-8f1c-4b34-bf9b-1fc87a3bc258
		dataCategory: Uncategorized

	measure 'SP Totali per Epic' = EXTERNALMEASURE("SP Totali per Epic", DOUBLE, "DirectQuery in Analysis Services - SpringLab")
		lineageTag: c77d758e-d409-4bda-a5de-b1d8260d0ee3
		sourceLineageTag: 7e24c4ae-82b5-43da-a897-27c6bf24a15c
		dataCategory: Uncategorized

	measure 'Giorni Impiegati' =
			
			VAR _Start = MIN('Jira Epic'[start_date])
			VAR _End = MAX('Jira Epic'[end_date])
			RETURN
			    IF(
			        ISBLANK(_Start),
			        BLANK(),
			        IF(
			            ISBLANK(_End),
			            DATEDIFF(_Start, TODAY(), DAY),
			            DATEDIFF(_Start, _End, DAY)
			        )
			    )
		formatString: 0
		lineageTag: 6701f196-f682-4664-9ee5-4a7c0f92fd24

		changedProperty = Name

