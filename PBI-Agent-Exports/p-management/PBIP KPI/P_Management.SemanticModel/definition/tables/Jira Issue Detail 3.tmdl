	column 'Creation date' =
			
			IF (
			    YEAR ( 'Jira Issue Detail 3'[created_date] ) < 2026,
			    DATE ( 1999, 1, 1 ),
			    'Jira Issue Detail 3'[created_date]
			)
		formatString: General Date
		lineageTag: 93c4d4c5-81a3-4305-999a-41f0e8d22eb2
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

