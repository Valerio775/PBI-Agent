	column 'FD Giorni nello stato' =
			
			VAR currentIssue = 'FD Transition Status'[issue_key]
			VAR currentStatus = 'FD Transition Status'[to_status]
			
			VAR startDate =
			    CALCULATE(
			        MIN('FD Transition Status'[transition_date]),
			        ALLEXCEPT('FD Transition Status', 'FD Transition Status'[issue_key], 'FD Transition Status'[to_status])
			    )
			
			VAR DataCreazioneOpen =
			    LOOKUPVALUE(
			        'Jira Feature Delivery 2'[Issue created date],
			        'Jira Feature Delivery 2'[Issue Key [Issue]]], currentIssue
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open",// && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
		formatString: 0
		displayFolder: OP36 Journey
		lineageTag: 73f52248-4f02-4e2a-b1df-2b02f55f09f3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'To OrdineFase Semplificate' =
			
			LOOKUPVALUE (
			    'Workflow Fasi FD Semplificate'[OrdineFase],
			    'Workflow Fasi FD Semplificate'[Status],
			    'FD Transition Status'[to_status]
			)
