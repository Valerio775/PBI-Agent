	measure 'Destinazione Dinamica ToolTip FD' = ```
			
			VAR _issueKeySelezionato = SELECTEDVALUE('Jira Feature Delivery'[Issue Key [Issue]]])
			
			
			VAR _statoDaIssue = 
			    IF(
			        NOT ISBLANK(_issueKeySelezionato),
			        CALCULATE(
			            SELECTEDVALUE('Jira Feature Delivery'[Issue status]),
			            'Jira Feature Delivery'[Issue Key [Issue]]] = _issueKeySelezionato
			        )
			    )
			
			VAR _statoDaTabella = SELECTEDVALUE('Workflow Fasi FD Journey Confluence'[Status Tradotto])
			
			
			VAR _statoCorrente = COALESCE(_statoDaTabella, _statoDaIssue)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        _statoCorrente = "In Progress", "Documento Comala FD",
			        _statoCorrente = "UAT ENV Preparation", "Documento Comala FD",
			        _statoCorrente = "UAT", "Documento Comala FD",
			        _statoCorrente = "Release", "Documento Comala FD"
			    )
			```
		lineageTag: 06aa4220-dd58-49ff-9056-9cdea58754df

	measure 'COUNT FD Backlog Semplificato' =
			
			VAR StatiDellaFase =
			    VALUES (
			        'Workflow Fasi FD Semplificate'[Status]
			    )
			
			RETURN
			CALCULATE (
			    DISTINCTCOUNT (
			        'Jira Feature Delivery'[Issue Key [Issue]]]
			    ),
			    TREATAS (
			        StatiDellaFase,
			        'Jira Feature Delivery'[Issue status]
			    )
			)
		formatString: 0
		displayFolder: Executive Journey
		lineageTag: f77be9f8-7a6c-43fb-a645-ff36b7f65129

	measure 'FD Tempo Storico Medio nello Stato Semplificato' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi FD Semplificate'[OrdineFase]
			    )
			
			VAR TransizioniEntrata =
			    SELECTCOLUMNS (
			        FILTER (
			            ALL ( 'FD Transition Status' ),
			            'FD Transition Status'[To OrdineFase Semplificate] = OrdineFaseCorrente
			                &&
			            'FD Transition Status'[From OrdineFase Semplificate] <> OrdineFaseCorrente
			        ),
			        "ie_issue_key", 'FD Transition Status'[issue_key],
			        "ie_data", 'FD Transition Status'[transition_date]
			    )
			
			VAR TransizioniUscita =
			    SELECTCOLUMNS (
			        FILTER (
			            'FD Transition Status',
			            'FD Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			                &&
			            'FD Transition Status'[To OrdineFase Semplificate] <> OrdineFaseCorrente
			        ),
			        "iu_issue_key", 'FD Transition Status'[issue_key],
			        "iu_data", 'FD Transition Status'[transition_date]
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE (
			        VALUES ( 'FD Transition Status'[issue_key] ),
			        FILTER (
			            ALL ( 'FD Transition Status' ),
			            'FD Transition Status'[To OrdineFase Semplificate] = OrdineFaseCorrente
			                ||
			            'FD Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS (
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'FD Transition Status'[issue_key]
			        VAR entrateIssue =
			            FILTER ( TransizioniEntrata, [ie_issue_key] = issueKey )
			        VAR usciteIssue =
			            FILTER ( TransizioniUscita, [iu_issue_key] = issueKey )
			
			        RETURN
			            SUMX (
			                FILTER (
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN
			                        COUNTROWS (
			                            FILTER (
			                                usciteIssue,
			                                [iu_data] > dataEntrata
			                            )
			                        ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX (
			                        FILTER (
			                            usciteIssue,
			                            [iu_data] > dataEntrata
			                        ),
			                        [iu_data]
			                    )
			                RETURN
			                    DATEDIFF (
			                        dataEntrata,
			                        primaUscita,
			                        DAY
			                    )
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        tabellaGiorni,
			        NOT ISBLANK ( [giorni_totali] )
			    ),
			    [giorni_totali]
			)
		displayFolder: Executive Journey
		lineageTag: 823039c1-2570-427f-94b7-21f0d29a44d4

	measure 'FD Aging Medio Corrente nello Stato Semplificato' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi FD Semplificate'[OrdineFase]
			    )
			
			VAR StatiDellaFase =
			    CALCULATETABLE (
			        VALUES ( 'Workflow Fasi FD Semplificate'[Status] ),
			        FILTER (
			            ALL ( 'Workflow Fasi FD Semplificate' ),
			            'Workflow Fasi FD Semplificate'[OrdineFase]
			                = OrdineFaseCorrente
			        )
			    )
			
			VAR IssueAttualmenteInFase =
			    CALCULATETABLE (
			        VALUES ( 'Jira Feature Delivery'[Issue Key [Issue]]] ),
			        TREATAS (
			            StatiDellaFase,
			            'Jira Feature Delivery'[Issue status]
			        )
			    )
			
			VAR TabellaAging =
			    ADDCOLUMNS (
			        IssueAttualmenteInFase,
			
			        "DataEntrataFase",
			
			        VAR CurrentIssue =
			            'Jira Feature Delivery'[Issue Key [Issue]]]
			
			        VAR UltimaEntrata =
			            CALCULATE (
			                MAX ( 'FD Transition Status'[transition_date] ),
			
			                FILTER (
			                    ALL ( 'FD Transition Status' ),
			                    'FD Transition Status'[issue_key] = CurrentIssue
			                        &&
			                    'FD Transition Status'[To OrdineFase Semplificate]
			                        = OrdineFaseCorrente
			                        &&
			                    'FD Transition Status'[From OrdineFase Semplificate]
			                        <> OrdineFaseCorrente
			                )
			            )
			
			        VAR CreatedDate =
			            CALCULATE (
			                MAX ( 'Jira Feature Delivery'[Issue created date] )
			            )
			
			        RETURN
			            IF (
			                OrdineFaseCorrente = 1,
			                COALESCE ( UltimaEntrata, CreatedDate ),
			                UltimaEntrata
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        TabellaAging,
			        NOT ISBLANK ( [DataEntrataFase] )
			    ),
			    DATEDIFF (
			        [DataEntrataFase],
			        TODAY (),
			        DAY
			    )
			)
		displayFolder: Executive Journey
		lineageTag: 15025c7b-8786-4da3-a119-eeefc4a02407

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'COUNT FD Dinamico Tempo' =
			
			VAR NumeroFasiVisibili =
			    COUNTROWS (
			        VALUES (
			            'Workflow Fasi FD Semplificate'[OrdineFase]
			        )
			    )
			
			RETURN
			IF (
			    NumeroFasiVisibili = 1,
			    [Conteggio Pass-Through FD Semplificato],
			    [FD Throughput Totale Mensile]
			)
		displayFolder: Executive Journey
		lineageTag: d61d352f-9930-4710-be3e-cece1bc4af59

