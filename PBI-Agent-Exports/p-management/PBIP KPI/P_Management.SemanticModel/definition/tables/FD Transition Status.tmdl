table 'FD Transition Status'
	lineageTag: cdc0b25b-8f21-4f97-a011-364aa8aecee7

	measure 'Filtro_Tabella_Dinamica FD' = ```
			
			VAR _End = [ToStatus_FD]
			
			-- Recuperiamo l'intervallo del mese selezionato nel report
			VAR _MinDate = MIN('FD Transition Status'[transition_date]) 
			VAR _MaxDate = MAX('FD Transition Status'[transition_date])
			
			RETURN
			IF( 
			    -- 1. Esiste la data di fine?
			    NOT ISBLANK(_End) 
			    
			    -- 2. La data di fine (Approved) è nel mese selezionato?
			    && _End >= _MinDate 
			    && _End <= _MaxDate, 
			    1, 
			    0 
			)
			```
		lineageTag: e967f466-d63d-4f67-a8dc-aad3c40c3119

	measure 'FD conteggio giorni' =
			
			
			VAR issueKey = SELECTEDVALUE('Jira Feature Delivery 2'[Issue Key [Issue]]])
			VAR currentStatus = SELECTEDVALUE('Jira Feature Delivery 2'[Issue status])
			
			VAR startDate =
			    CALCULATE(
			        MIN('FD Transition Status'[transition_date]),
			        FILTER(
			            ALL('FD Transition Status'),
			            'FD Transition Status'[issue_key] = issueKey
			                && 'FD Transition Status'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Feature Delivery 2'[Issue created date]),
			        REMOVEFILTERS('Jira Feature Delivery 2'),
			        'Jira Feature Delivery 2'[Issue Key [Issue]]] = issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open",// && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
		formatString: 0
		displayFolder: OP36 Journey
		lineageTag: 5a6311cc-3b2d-42f3-b069-7edee2d64a0f

	measure 'FD Data Ingresso' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Feature Delivery 2'[Issue Key [Issue]]])
			VAR StatoCorrente = SELECTEDVALUE('Jira Feature Delivery 2'[Issue status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('FD Transition Status'[transition_date]),
			        FILTER(
			            ALL('FD Transition Status'),
			            'FD Transition Status'[issue_key] = IssueCorrente
			                && 'FD Transition Status'[to_status] = StatoCorrente
			                && 'FD Transition Status'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Feature Delivery 2'[Issue created date]),
			        'Jira Feature Delivery 2'[Issue Key [Issue]]] = IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open",// && ISBLANK(DataDaTransizioni),
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: OP36 Journey
		lineageTag: 238a7617-6cd3-4c68-b458-bd0a33a4b021

	measure 'FD Media giorni in stato' =
			
			AVERAGEX(
			    VALUES('Jira Feature Delivery 2'[Issue Key [Issue]]]),
			    CALCULATE(MIN('FD Transition Status'[FD Giorni nello stato]))
			)
		displayFolder: OP36 Journey
		lineageTag: b2335f91-cd28-4c96-8085-767919aa1394

