	measure 'Conteggio Pass-Through FD Semplificato' =
			
			VAR OrdineFaseCorrente =
			    MAX (
			        'Workflow Fasi FD Semplificate'[OrdineFase]
			    )
			
			RETURN
			IF (
			    ISBLANK ( OrdineFaseCorrente ),
			    BLANK (),
			    CALCULATE (
			        DISTINCTCOUNT ( 'FD Transition Status'[issue_key] ),
			        FILTER (
			            'FD Transition Status',
			            'FD Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			                &&
			            'FD Transition Status'[To OrdineFase Semplificate] <> OrdineFaseCorrente
			                &&
			            NOT ISBLANK ( 'FD Transition Status'[From OrdineFase Semplificate] )
			                &&
			            NOT ISBLANK ( 'FD Transition Status'[To OrdineFase Semplificate] )
			        )
			    )
			)
		formatString: 0
		displayFolder: Executive Journey
		lineageTag: cd3211bc-524b-4ad7-a409-d5662685f887

