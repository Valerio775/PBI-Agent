	column 'Lead Time - Authorized_ReadyForUAT' = ```
			
			
			VAR _startDate = 
			    CALCULATE (
			        MIN ( 'FD Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'FD Transition Status', 'FD Transition Status'[issue_key] ),
			        'FD Transition Status'[from_status] = "Authorized",
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			VAR _lastDate = 
			    CALCULATE (
			        MAX ( 'FD Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'FD Transition Status', 'FD Transition Status'[issue_key] ),
			        'FD Transition Status'[to_status] = "Ready for UAT",
			        'FD Transition Status'[from_status] <> "Ready for UAT",
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			RETURN 
			IF ( 
			    'FD Transition Status'[to_status] = "Ready for UAT" 
			        && 'FD Transition Status'[transition_date] = _lastDate
			        && NOT ISBLANK ( _startDate ),
			    'FD Transition Status'[transition_date] - _startDate,
			    BLANK()
			)
			```
		formatString: General Date
		lineageTag: 2b0c127a-d820-466c-9ba1-dde6a2c6f081
