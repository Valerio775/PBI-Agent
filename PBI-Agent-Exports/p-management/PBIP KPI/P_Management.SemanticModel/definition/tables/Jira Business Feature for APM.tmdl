	measure 'Feature for APM Progress' = EXTERNALMEASURE("Feature for APM Progress", DOUBLE, "DirectQuery in Analysis Services - SpringLab")
		formatString: 0.00
		lineageTag: 244c2d5b-414f-43f9-8bd1-dd3bf402fd60
		sourceLineageTag: 77eb6cfd-01c2-4309-bb7f-657c62e5dde3
