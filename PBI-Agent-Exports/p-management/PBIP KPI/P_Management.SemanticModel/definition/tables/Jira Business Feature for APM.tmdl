	measure 'APM Issue con più FD' =
			
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            VALUES('Jira Business Feature for APM'[Issue]),
			            CALCULATE(
			                DISTINCTCOUNT('Jira Feature Delivery'[Issue])
			            ) >= 2
			        )
			    )
			)
		formatString: 0
		lineageTag: c2c7668f-0bdd-421c-9434-7001b5c05a62

		changedProperty = Name

