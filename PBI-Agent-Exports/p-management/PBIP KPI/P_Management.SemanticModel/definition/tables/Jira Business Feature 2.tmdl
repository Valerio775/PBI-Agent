			    FILTER(
			        'Confluence Comala Issue Link',
			        'Confluence Comala Issue Link'[issue_key] = "BCADDCCTA-34"
			    ),
			    'Confluence Comala Issue Link'[issue_type] & " | " & 'Confluence Comala Issue Link'[pageid],
			    "; "
