			        DATEDIFF(_minDataWaitingForUAT, _maxDataWaitingForUAT, DAY)
			    )
			```
		formatString: 0
		displayFolder: Documentazione Comala UAT XRAY
		lineageTag: a5a90c4a-ee5e-4a6a-8d05-534771e4edd1

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Test Righe Collegate' =
			
