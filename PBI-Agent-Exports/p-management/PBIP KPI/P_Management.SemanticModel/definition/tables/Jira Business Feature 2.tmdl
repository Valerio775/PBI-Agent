	measure 'Tempo per Approvazione IC DU BF' = ```
			
			VAR _dataEstimationApproval = 
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        'BF Transition Status'[to_status] = "Estimation Approval"
			    )
			VAR _dataDone = 
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        'IE Transition Status'[to_status] = "Done"
