	measure 'Data Ingresso Draft BF' =
			VAR _IssueKeyNorm =
			    UPPER ( TRIM ( SELECTEDVALUE ( 'Jira Business Feature 2'[Issue key] ) ) )
			VAR _PageIds =
			    SELECTCOLUMNS (
			        FILTER (
			            ALL ( 'Confluence Comala Issue Link' ),
			            UPPER ( TRIM ( 'Confluence Comala Issue Link'[issue_key] ) ) = _IssueKeyNorm
			        ),
			        "pageid", 'Confluence Comala Issue Link'[pageid]
			    )
			RETURN
			    IF (
			        ISBLANK ( _IssueKeyNorm ),
			        BLANK (),
			        CALCULATE (
			            MINX (
			                FILTER (
			                    ALL ( 'Confluence Comala Activity' ),
			                    LOWER ( TRIM ( COALESCE ( 'Confluence Comala Activity'[Comala Stato Documento], "" ) ) ) = "in draft"
			                ),
			                COALESCE (
			                    'Confluence Comala Activity'[Date Convertita],
			                    DATEVALUE ( LEFT ( 'Confluence Comala Activity'[date], 10 ) )
			                        + TIMEVALUE ( MID ( 'Confluence Comala Activity'[date], 12, 8 ) )
			                )
			            ),
			            TREATAS ( _PageIds, 'Confluence Comala Activity'[pageid] )
			        )
			    )
		formatString: General Date
		displayFolder: Documento Comala Ready for UAT
		lineageTag: c0ba2406-083d-4652-957d-e6d6b570289b

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Data Ingresso Initial BF' =
			
			CALCULATE(
			    MIN('Confluence Comala Activity'[Date Convertita]),
			    'Confluence Comala Activity'[Comala Stato Documento] = "Initial",
			    TREATAS(
			        VALUES('Jira Business Feature 2'[Issue Key [Issue]]]),
			        'Confluence Comala Issue Link'[issue_key]
			    )
			)
		formatString: General Date
		displayFolder: Documento Comala Ready for UAT
		lineageTag: 6e874b63-7f49-4823-88c3-a639e5e642ae

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Data Ingresso Approved BF' =
			
