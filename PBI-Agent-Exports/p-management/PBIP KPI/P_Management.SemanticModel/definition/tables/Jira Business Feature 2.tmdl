	measure 'BF Tech Progress' =
			
			var x = DIVIDE(
			    SUMX(
			        VALUES('Jira Business Feature for APM 2'[Issue]),
			        CALCULATE([FfA Tech Progress]) *
			        CALCULATE(COUNTROWS('Jira Issue Detail 3'))
			    ),
			    SUMX(
			        VALUES('Jira Business Feature for APM 2'[Issue]),
			        CALCULATE(COUNTROWS('Jira Issue Detail 3'))
			    )
			)
			RETURN COALESCE(x, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f0d75677-bdb2-4a53-95d1-92d0180a3325

		changedProperty = Name

		changedProperty = FormatString

	measure 'FfA Tech Progress' =
			
			DIVIDE(
			    SUMX(
			        VALUES('Jira Feature Delivery 2'[Issue]),
			        CALCULATE([Estimation Effort %]) *
			        CALCULATE(COUNTROWS('Jira Issue Detail 3'))
			    ),
			    SUMX(
			        VALUES('Jira Feature Delivery 2'[Issue]),
			        CALCULATE(COUNTROWS('Jira Issue Detail 3'))
			    )
			)
		lineageTag: f58a1e63-1404-4013-addb-509a568da266

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conteggio BF' =
			
			CALCULATE(
			    DISTINCTCOUNT('Jira Business Feature 2'[Issue Key [Issue]]]),
			    FILTER('Jira Business Feature 2',
			        not ISBLANK('Jira Business Feature 2'[Issue status]) && not ISBLANK('Jira Business Feature 2'[Issue Key [Issue]]])
			),
			    'Jira Project List 2'[Project_Status] <> "Demo Project")
		formatString: #,0
		lineageTag: 5d4c8ff8-6094-45c2-bca1-7f923c325c39

		changedProperty = Name

		changedProperty = FormatString

	measure 'Conteggio BF Authorized in su' =
			CALCULATE(
			    DISTINCTCOUNT('Jira Business Feature 2'[Issue Key [Issue]]]),
			    FILTER('Jira Business Feature 2',
			        not ISBLANK('Jira Business Feature 2'[Issue status]) && not ISBLANK('Jira Business Feature 2'[Issue Key [Issue]]]) &&
			'Jira Business Feature 2'[Issue status] in {"Authorized", "In Progress", "Ready for UAT", "Completed", "Confirm Released", "UAT Passed"}))
		formatString: #,0
		lineageTag: 2acf0ee0-f6e0-422d-92f5-362b6f8ed6e6

		changedProperty = Name

		changedProperty = FormatString

	measure 'Tempo della Chiamata DU per HLD BF' = ```
			
			
			VAR _issueKey =
			    SELECTEDVALUE('Jira Business Feature 2'[Issue Key [Issue]]])
			
			VAR _dataApprovedComala =
			    CALCULATE(
			        MIN('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Approved"
			    )
			
			VAR _dataInitialComala =
			    CALCULATE(
			        MIN('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Initial"
			    )
			/*
			var _test = 
			CALCULATE(
			    MIN('BF Transition Status'[transition_date]),
			    'BF Transition Status'[issue_key] = _issueKey,
			    'BF Transition Status'[to_status] = "Ready for UAT"
			)
			*/
			
			RETURN
			
			    DATEDIFF(_dataInitialComala, _dataApprovedComala, DAY)
			
			
			```
		formatString: 0
		displayFolder: Documento Comala Ready for UAT
		lineageTag: 4b71dfd5-b1b8-4073-b1ec-293fcd7b96ac

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Tempo per Approvazione HLD da DE BF' = ```
			
			VAR _issueKey =
			    SELECTEDVALUE('Jira Business Feature 2'[Issue Key [Issue]]])
			
			VAR _dataDraftComala =
			    CALCULATE(
			        MIN('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "In Draft",
			        TREATAS(
			            VALUES('Jira Business Feature 2'[Issue Key [Issue]]]),
			            'Confluence Comala Issue Link'[issue_key]
			        ),
			        'Confluence Comala Issue Link'[issue_type] = "Business Feature"
			    )
			
			VAR _dataReview =
			    CALCULATE(
			        MAX('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "In Review",
			        TREATAS(
			            VALUES('Jira Business Feature 2'[Issue Key [Issue]]]),
			            'Confluence Comala Issue Link'[issue_key]
			        ),
			        'Confluence Comala Issue Link'[issue_type] = "Business Feature"
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(_dataDraftComala)
			        && NOT ISBLANK(_dataReview),
			    DATEDIFF(_dataDraftComala, _dataReview, DAY)
			)
			
			```
		formatString: 0
		displayFolder: Documento Comala Ready for UAT
		lineageTag: ff9bc8d7-b13e-4517-8033-69602ded9c3a

		changedProperty = DisplayFolder

		changedProperty = Name

