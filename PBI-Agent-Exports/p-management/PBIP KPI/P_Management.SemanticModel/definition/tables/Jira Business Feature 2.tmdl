	column 'Status Tradotto' =
			
			SWITCH(
			    'Jira Business Feature 2'[Issue status],
			    "In Progress",                          "In Progress",
			    "Ready for UAT",                              "UAT",
			    "Waiting for UAT Approval", "UAT",
			    "Completed",                   "Release",
			    "Confirm Released",                   "Release"
			)
		lineageTag: b88a78c0-ca5f-475e-a4ec-1b9fc1a3bd48
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'IM Num formatted' = ```
			
			var _issueNumber = LOOKUPVALUE('Jira Investment Memo'[Issue_Number], 'Jira Investment Memo'[Issue_key], 
			'Jira Business Feature 2'[Issue Investment Memo])
			
			var _issueProjectName = LOOKUPVALUE('Jira Investment Memo'[Issue_Project_Name], 'Jira Investment Memo'[Issue_key], 
			'Jira Business Feature 2'[Issue Investment Memo])
			
			return 
			_issueNumber & " - " & _issueProjectName
			```
		lineageTag: 9296ea0b-d5a6-4c21-88de-6b20f89c8267
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

