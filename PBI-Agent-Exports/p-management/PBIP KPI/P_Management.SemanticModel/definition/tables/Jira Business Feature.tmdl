	measure 'Tempo della DU per HLD BF' =
			
			
			VAR dataInizital = [Data Stato Initial BF (Confluence)]
			VAR dataDraft = [Data Stato Approved BF (Confluence)]
			RETURN
			IF(
			    NOT ISBLANK(dataInizital) && NOT ISBLANK(dataDraft),
			    DATEDIFF(dataInizital, dataDraft, DAY)
			)
		formatString: 0
		displayFolder: Documento Confluence
		lineageTag: 9a4eebdc-5be9-40db-bdb3-73d127daf82f

		changedProperty = DisplayFolder

		changedProperty = Name

