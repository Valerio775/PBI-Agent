	measure 'Esecuzione UAT BF 2' = ```
			
			VAR _minDataReadyForUAT = 
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        'BF Transition Status'[to_status] = "Ready for UAT"
			    )
			VAR _maxDataReadyForUAT = 
			    CALCULATE(
			        MAX('BF Transition Status'[transition_date]),
			        'BF Transition Status'[to_status] = "Ready for UAT"
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_minDataReadyForUAT) && NOT ISBLANK(_maxDataReadyForUAT),
			        DATEDIFF(_minDataReadyForUAT, _maxDataReadyForUAT, DAY)
			    )
			```
		formatString: 0
		lineageTag: 165f0a76-bf69-421b-8eeb-77323eabb39d

		changedProperty = Name

