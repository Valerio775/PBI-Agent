	measure 'Data Stato Initial BF (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Business Feature'[Issue Key [Issue]]] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence BF Pages',
			            "pageid", 'Confluence BF Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] ),
			        'Confluence Comala Issue Link'[confluence_labels] = "uat_results;demand_business_approval"
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Initial"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documento Confluence
		lineageTag: 2952ebe8-802d-405c-aecd-1beb9705b071

		changedProperty = Name

		changedProperty = DisplayFolder

