			            ALL('BF Transition Status'),
			            'BF Transition Status'[issue_key] = issueKey
			                && (
			                    'BF Transition Status'[to_status] = "Ready for UAT"
			                    || 'BF Transition Status'[to_status] = "Waiting for UAT Approval"
			                )
			        )
			    )
			
			RETURN
			IF(
			    StatusTradotto = "UAT",
			    DataUscitaUAT,
			    DataUscitaGenerica
			)*/
			```
