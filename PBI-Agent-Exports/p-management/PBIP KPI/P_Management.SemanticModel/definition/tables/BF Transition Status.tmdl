	measure 'Destinazione Dinamica ToolTip BF' = ```
			
			VAR _issueKeySelezionato = SELECTEDVALUE('Jira Business Feature 2'[Issue Key [Issue]]])
			
			VAR _statoDaIssue = 
			    IF(
			        NOT ISBLANK(_issueKeySelezionato),
			        CALCULATE(
			            SELECTEDVALUE('Jira Business Feature 2'[Status Tradotto]),
			            'Jira Business Feature 2'[Issue Key [Issue]]] = _issueKeySelezionato
			        )
			    )
			
			VAR _statoDaTabella = SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto])
			
			VAR _statoCorrente = COALESCE(_statoDaTabella, _statoDaIssue)
			
			VAR _uatTestType = 
			    IF(
			        NOT ISBLANK(_issueKeySelezionato),
			        CALCULATE(
			            SELECTEDVALUE('Jira Business Feature 2'[Issue UAT Test Type]),
			            'Jira Business Feature 2'[Issue Key [Issue]]] = _issueKeySelezionato
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        _statoCorrente = "In Progress", "Drill-through Estimation Details FD",
			        _statoCorrente = "UAT" && _uatTestType = "Confluence OP-36", "Documento Comala UAT-TEST Confluence",
			        _statoCorrente = "UAT" && _uatTestType = "Xray Test Management", "Documento Comala XRAY"
			    )
			```
