	measure 'Data Uscita Stato_BF' = ```
			
			VAR issueKey = SELECTEDVALUE('BF Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto])
