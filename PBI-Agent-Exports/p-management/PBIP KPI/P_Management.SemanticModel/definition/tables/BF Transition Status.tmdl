	measure 'Filtro_Tabella_Dinamica BF' = ```
			
			VAR _End = [ToStatus_BF]
			
			-- Recuperiamo l'intervallo del mese selezionato nel report
			VAR _MinDate = MIN('BF Transition Status'[transition_date]) 
			VAR _MaxDate = MAX('BF Transition Status'[transition_date])
			
			RETURN
			IF( 
			    -- 1. Esiste la data di fine?
			    NOT ISBLANK(_End) 
			    
			    -- 2. La data di fine (Approved) è nel mese selezionato?
			    && _End >= _MinDate 
			    && _End <= _MaxDate, 
			    1, 
			    0 
			)
			```
		formatString: 0
		lineageTag: 06c3c637-d6c2-4688-b5b5-8a257f0eec5d

	measure 'Media per Stato BF' =
			
			AVERAGEX(
			    VALUES('BF Transition Status'[issue_key]),
			    CALCULATE(MIN('BF Transition Status'[Giorni_In_Stato_Colonna]))
			)
		displayFolder: Grafico 1
		lineageTag: 2e71569d-bd23-4ad8-8e8f-69ec5d13eb82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Ingresso BF' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Business Feature 2'[Issue key])
			VAR StatoCorrente = SELECTEDVALUE('Jira Business Feature 2'[Issue status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('BF Transition Status'[transition_date]),
			        FILTER(
			            ALL('BF Transition Status'),
			            'BF Transition Status'[issue_key] = IssueCorrente
			                && 'BF Transition Status'[to_status] = StatoCorrente
			                && 'BF Transition Status'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    LOOKUPVALUE(
			        'Jira Business Feature 2'[Issue created date],
			        'Jira Business Feature 2'[Issue key], IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open",
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Grafico 1
		lineageTag: 5605e5c5-af18-408e-8a86-4ed6bc897cc9

	measure 'Conteggio Pass-Through BF' =
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey 2'),
			            'Workflow Fasi BF Journey 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey 2'[Status], "Open")
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status'),
			                'BF Transition Status'[from_status] IN StatiDellaFase
			                    && NOT('BF Transition Status'[to_status] IN StatiDellaFase)
			                    && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'BF Transition Status'[issue_key],
			            "iu_data", 'BF Transition Status'[transition_date]
			        )
			    )
			
			RETURN
			IF(
			    IsOpen,
			    COUNTROWS(
			        CALCULATETABLE(
			            VALUES('BF Transition Status'[issue_key]),
			            FILTER(
			                ALL('BF Transition Status'),
			                'BF Transition Status'[from_status] IN StatiDellaFase
			                && NOT('BF Transition Status'[to_status] IN StatiDellaFase)
			                && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			            )
			        )
			    ),
			    VAR TransizioniEntrata =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL('BF Transition Status'),
			                    'BF Transition Status'[to_status] IN StatiDellaFase
			                ),
			                "ie_issue_key", 'BF Transition Status'[issue_key],
			                "ie_data", 'BF Transition Status'[transition_date]
			            )
			        )
			    VAR IssueUscite =
			        CALCULATETABLE(
			            VALUES('BF Transition Status'[issue_key]),
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES('BF Transition Status'[issue_key]),
			                    "HasCoppiaCompleta",
			                    VAR currentKey = 'BF Transition Status'[issue_key]
			                    VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = currentKey)
			                    VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = currentKey)
			                    RETURN
			                        COUNTROWS(
			                            FILTER(
			                                entrateIssue,
			                                VAR dataEntrata = [ie_data]
			                                RETURN
			                                    COUNTROWS(
			                                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                                    ) > 0
			                            )
			                        ) > 0
			                ),
			                [HasCoppiaCompleta] = TRUE()
			            )
			        )
			    RETURN
			    CALCULATE(
			        DISTINCTCOUNT('BF Transition Status'[issue_key]),
			        FILTER(
			            ALL('BF Transition Status'),
			            'BF Transition Status'[to_status] IN StatiDellaFase
			            && 'BF Transition Status'[issue_key] IN IssueUscite
			        )
			    )
			)
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: bfd0b81d-8320-49ff-8a2f-dedf57982617

	measure 'Tempo Medio nello Stato BF' = ```
			
			VAR StatusTradotto = 
			    SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey 2'),
			            IF(
			                ISBLANK(StatusTradotto),
			                TRUE(),
			                'Workflow Fasi BF Journey 2'[Status Tradotto] = StatusTradotto
			            )
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey 2'[Status], "Open")
			
			VAR TransizioniEntrata =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status'),
			                'BF Transition Status'[to_status] IN StatiDellaFase
			                && NOT('BF Transition Status'[from_status] IN StatiDellaFase)
			                && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			            ),
			            "ie_issue_key", 'BF Transition Status'[issue_key],
			            "ie_data", 'BF Transition Status'[transition_date]
			        )
			    )
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status'),
			                'BF Transition Status'[from_status] IN StatiDellaFase
			                && NOT('BF Transition Status'[to_status] IN StatiDellaFase)
			                && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'BF Transition Status'[issue_key],
			            "iu_data", 'BF Transition Status'[transition_date]
			        )
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE(
			        VALUES('BF Transition Status'[issue_key]),
			        FILTER(
			            ALL('BF Transition Status'),
			            'BF Transition Status'[to_status] IN StatiDellaFase
			            || 'BF Transition Status'[from_status] IN StatiDellaFase
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS(
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'BF Transition Status'[issue_key]
			        VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = issueKey)
			        VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = issueKey)
			        VAR sommaSoggiorni =
			            SUMX(
			                FILTER(
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN COUNTROWS(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                    ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata),
			                        [iu_data]
			                    )
			                RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			            )
			        RETURN 
			            IF(
			                ISBLANK(sommaSoggiorni) && IsOpen,
			                0,
			                IF(NOT ISBLANK(sommaSoggiorni), sommaSoggiorni, BLANK())
			            )
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(tabellaGiorni, NOT ISBLANK([giorni_totali])),
			    [giorni_totali]
			)
			```
		displayFolder: Grafico 2
		lineageTag: e5330717-68f4-423b-a492-cbae9e26aa60

