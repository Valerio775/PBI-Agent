			VAR y = CONVERT(YEAR ( 'BF Transition Status'[transition_date] ), STRING)
			VAR m = MONTH ( 'BF Transition Status'[transition_date]  )
			VAR mShort =
			    SWITCH (
			        m,
			        1, "01", 2, "02", 3, "03", 4, "04", 5, "05", 6, "06",
			        7, "07", 8, "08", 9, "09", 10, "10", 11, "11", 12, "12"
			    )
