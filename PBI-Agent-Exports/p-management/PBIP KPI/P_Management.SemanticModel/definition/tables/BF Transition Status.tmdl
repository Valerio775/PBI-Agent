	column 'Lead Time - InProgress_ConfirmReleased' = ```
			
			
			VAR _startDate = 
			    CALCULATE (
			        MIN ( 'BF Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'BF Transition Status', 'BF Transition Status'[issue_key] ),
			        'BF Transition Status'[from_status] = "In Progress",
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			VAR _lastDate = 
			    CALCULATE (
			        MAX ( 'BF Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'BF Transition Status', 'BF Transition Status'[issue_key] ),
			        'BF Transition Status'[to_status] = "Confirm Released",
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			RETURN 
			IF ( 
			    'BF Transition Status'[to_status] = "Confirm Released" 
			        && 'BF Transition Status'[transition_date] = _lastDate
			        && NOT ISBLANK ( _startDate ),
			    'BF Transition Status'[transition_date] - _startDate,
			    BLANK()
			)
			```
