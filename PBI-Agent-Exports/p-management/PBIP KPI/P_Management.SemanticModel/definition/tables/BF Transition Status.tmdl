	measure 'Filtro Rework BF' = ```
			
			VAR FaseSelezionata = 
			    CALCULATE(
			        SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto]),
			        ALLSELECTED('Workflow Fasi BF Journey 2')
			    )
			
			VAR OrdineSelezionato =
			    IF(
			        NOT ISBLANK(FaseSelezionata),
			        MAXX(
			            FILTER(ALL('Workflow Fasi BF Journey 2'),
			                'Workflow Fasi BF Journey 2'[Status Tradotto] = FaseSelezionata),
			            'Workflow Fasi BF Journey 2'[OrdineFase]
			        ),
			        BLANK()
			    )
			
			VAR OrdineFromRiga = MAX('BF Transition Status'[OrdineFrom])
			VAR OrdineToRiga = MAX('BF Transition Status'[OrdineTo])
			
			RETURN
			IF(
			    NOT ISBLANK(OrdineFromRiga)
			    && NOT ISBLANK(OrdineToRiga)
			    && OrdineToRiga < OrdineFromRiga
			    && (ISBLANK(OrdineSelezionato) || OrdineFromRiga = OrdineSelezionato),
			    1, 0
			)
