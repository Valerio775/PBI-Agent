	column 'Giorni in Stato BF' = ```
			
			VAR issueKey = 'BF Transition Status'[issue_key]
			VAR currentStatus = 
			    LOOKUPVALUE(
			        'Jira Business Feature 2'[Issue status],
			        'Jira Business Feature 2'[Issue key], issueKey
			    )
			
			VAR startDate =
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        FILTER(
			            ALL('BF Transition Status'),
			            'BF Transition Status'[issue_key] = issueKey
			                && 'BF Transition Status'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen = 
			    LOOKUPVALUE(
			        'Jira Business Feature 2'[Issue created date],
			        'Jira Business Feature 2'[Issue key], issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open" && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
			```
		formatString: 0
		displayFolder: Grafico 1
		lineageTag: 55f091d2-740f-4471-8d70-7c8275a0dfcb
		summarizeBy: sum

