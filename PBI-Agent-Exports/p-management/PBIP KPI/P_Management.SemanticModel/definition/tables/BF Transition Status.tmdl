	measure 'Somma dei tempi nello stato BF' = ```
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey 2'[Status Tradotto])
			VAR issueKey = SELECTEDVALUE('BF Transition Status'[issue_key])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey 2'),
			            'Workflow Fasi BF Journey 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey 2'[Status], "Open")
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Business Feature 2'[Issue created date]),
			        REMOVEFILTERS('Jira Business Feature 2'),
			        'Jira Business Feature 2'[Issue key] = issueKey
			    )
			
			VAR entrateIssue =
			    FILTER(
			        ALL('BF Transition Status'),
			        'BF Transition Status'[issue_key] = issueKey
			        && 'BF Transition Status'[to_status] IN StatiDellaFase
			        && NOT('BF Transition Status'[from_status] IN StatiDellaFase)
			        && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			    )
			
			VAR usciteIssue =
			    FILTER(
			        ALL('BF Transition Status'),
			        'BF Transition Status'[issue_key] = issueKey
			        && 'BF Transition Status'[from_status] IN StatiDellaFase
			        && NOT('BF Transition Status'[to_status] IN StatiDellaFase)
			        && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			    )
			
			VAR primaUscitaOpen =
			    MINX(usciteIssue, 'BF Transition Status'[transition_date])
			
			VAR giorniOpen =
			    VAR primaEntrata = 
			        IF(
			            NOT ISBLANK(DataCreazioneOpen) && DataCreazioneOpen <= primaUscitaOpen,
			            DataCreazioneOpen,
			            primaUscitaOpen
			        )
			    VAR primaSoggiorno =
			        IF(
			            NOT ISBLANK(primaEntrata) && NOT ISBLANK(primaUscitaOpen) && primaEntrata < primaUscitaOpen,
			            DATEDIFF(primaEntrata, primaUscitaOpen, DAY),
			            0
			        )
			    VAR soggiorniSuccessivi =
			        SUMX(
			            FILTER(
			                entrateIssue,
			                VAR dataEntrata = 'BF Transition Status'[transition_date]
			                RETURN COUNTROWS(
			                    FILTER(usciteIssue, 'BF Transition Status'[transition_date] > dataEntrata)
			                ) > 0
			            ),
			            VAR dataEntrata = 'BF Transition Status'[transition_date]
			            VAR primaUscitaSucc =
			                MINX(
			                    FILTER(usciteIssue, 'BF Transition Status'[transition_date] > dataEntrata),
			                    'BF Transition Status'[transition_date]
			                )
			            RETURN DATEDIFF(dataEntrata, primaUscitaSucc, DAY)
			        )
			    RETURN primaSoggiorno + soggiorniSuccessivi
			
			VAR giorniAltriStati =
			    SUMX(
			        FILTER(
			            entrateIssue,
			            VAR dataEntrata = 'BF Transition Status'[transition_date]
			            RETURN COUNTROWS(
			                FILTER(usciteIssue, 'BF Transition Status'[transition_date] > dataEntrata)
			            ) > 0
			        ),
			        VAR dataEntrata = 'BF Transition Status'[transition_date]
			        VAR primaUscita =
			            MINX(
			                FILTER(usciteIssue, 'BF Transition Status'[transition_date] > dataEntrata),
			                'BF Transition Status'[transition_date]
			            )
			        RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			    )
			
			RETURN
			IF(IsOpen, giorniOpen, giorniAltriStati)
			```
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 5bf00497-524f-4cab-a6a7-d831f8a3040b

	measure 'Conteggio Rework per Stato BF' = ```
			
			VAR StatoCorrente = MAX('Workflow Fasi BF Journey 2'[Status Tradotto])
			VAR OrdineCorrente = 
			    MAXX(
			        FILTER(
			            ALL('Workflow Fasi BF Journey 2'),
			            'Workflow Fasi BF Journey 2'[Status Tradotto] = StatoCorrente
			        ),
			        'Workflow Fasi BF Journey 2'[OrdineFase]
			    )
			
			RETURN
			COUNTROWS(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status'),
			                VAR CurrentFromStatus = 'BF Transition Status'[from_status]
			                VAR CurrentToStatus = 'BF Transition Status'[to_status]
			                VAR CurrentKey = 'BF Transition Status'[issue_key]
			                VAR CurrentDate = 'BF Transition Status'[transition_date]
			
			                VAR OrdineFrom =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi BF Journey 2'),
			                            'Workflow Fasi BF Journey 2'[Status] = CurrentFromStatus),
			                        'Workflow Fasi BF Journey 2'[OrdineFase]
			                    )
			                VAR OrdineTo =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi BF Journey 2'),
			                            'Workflow Fasi BF Journey 2'[Status] = CurrentToStatus),
			                        'Workflow Fasi BF Journey 2'[OrdineFase]
			                    )
			
			                VAR DataUscita =
			                    CALCULATE(
			                        MIN('BF Transition Status'[transition_date]),
			                        FILTER(
			                            ALL('BF Transition Status'),
			                            'BF Transition Status'[issue_key] = CurrentKey
			                            && 'BF Transition Status'[transition_date] > CurrentDate
			                            && 'BF Transition Status'[to_status] = CurrentFromStatus
			                            && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			                        )
			                    )
			
			                RETURN
			                    NOT ISBLANK(OrdineFrom)
			                    && NOT ISBLANK(OrdineTo)
			                    && OrdineTo < OrdineFrom
			                    && OrdineFrom = OrdineCorrente
			                    && NOT ISBLANK(DataUscita)
			            ),
			            "issue_key", 'BF Transition Status'[issue_key]
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 91f6b5fd-4fdd-493d-b4b2-54d603719ee8

	measure 'Media Giorni Rework BF' = ```
			
			VAR OrdineSelezionato = 
			    MAX('Workflow Fasi BF Journey 2'[OrdineFase])
			
			VAR TabellaFiltrata =
			    FILTER(
			        ALL('BF Transition Status'),
			        'BF Transition Status'[IsRework] = 1
			        && 'BF Transition Status'[OrdineFrom] = OrdineSelezionato
			    )
			
			RETURN
			IF(
			    ISBLANK(OrdineSelezionato),
			    BLANK(),
			    AVERAGEX(
			        TabellaFiltrata,
			        VAR DataIngresso = 'BF Transition Status'[transition_date]
			        VAR DataUscita = 
			            CALCULATE(
			                MIN('BF Transition Status'[transition_date]),
			                REMOVEFILTERS('Workflow Fasi BF Journey 2'),
			                FILTER(
			                    ALL('BF Transition Status'),
			                    'BF Transition Status'[issue_key] = EARLIER('BF Transition Status'[issue_key])
			                    && 'BF Transition Status'[transition_date] > EARLIER('BF Transition Status'[transition_date])
			                    && 'BF Transition Status'[to_status] = EARLIER('BF Transition Status'[from_status])
			                    && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			                )
			            )
			        RETURN
			        IF(
			            ISBLANK(DataUscita),
			            BLANK(), 
			            DATEDIFF(DataIngresso, DataUscita, DAY)
			        )
			    )
			)
			```
		displayFolder: Grafico 3
		lineageTag: 91a2b006-4b8c-45d8-9d63-fdfd040efa6d

	measure 'Media Rework per Stato BF' = ```
			
			VAR OrdineSelezionato = MAX('Workflow Fasi BF Journey 2'[OrdineFase])
			
			VAR RigheRework =
			    FILTER(
			        ALL('BF Transition Status'),
			        NOT ISBLANK('BF Transition Status'[OrdineFrom])
			        && NOT ISBLANK('BF Transition Status'[OrdineTo])
			        && 'BF Transition Status'[OrdineTo] < 'BF Transition Status'[OrdineFrom]
			        && NOT ISBLANK(OrdineSelezionato)
			        && 'BF Transition Status'[OrdineFrom] = OrdineSelezionato
			        && NOT ISBLANK(
			            CALCULATE(
			                MIN('BF Transition Status'[transition_date]),
			                FILTER(
			                    ALL('BF Transition Status'),
			                    'BF Transition Status'[issue_key] = EARLIER('BF Transition Status'[issue_key])
			                    && 'BF Transition Status'[transition_date] > EARLIER('BF Transition Status'[transition_date])
			                    && 'BF Transition Status'[to_status] = EARLIER('BF Transition Status'[from_status])
			                    && 'BF Transition Status'[from_status] <> 'BF Transition Status'[to_status]
			                )
			            )
			        )
			    )
			
			VAR TotaleEpisodi = COUNTROWS(RigheRework)
			
			VAR IssueDistinte = 
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(RigheRework, "issue_key", 'BF Transition Status'[issue_key])
			        )
			    )
			
			RETURN
			DIVIDE(TotaleEpisodi, IssueDistinte)
			```
