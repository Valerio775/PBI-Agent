	column Giorni_In_Stato_Colonna =
			
			VAR currentIssue = 'BF Transition Status'[issue_key]
			VAR currentStatus = 'BF Transition Status'[to_status]
			
			VAR startDate =
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        ALLEXCEPT('BF Transition Status', 'BF Transition Status'[issue_key], 'BF Transition Status'[to_status])
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDate),
			    DATEDIFF(startDate, TODAY(), DAY)
