table 'Jira Initiative Estimation'
	lineageTag: efba0e61-a037-48d4-88df-210f72279936
	sourceLineageTag: 3f8ffbb6-01b5-47db-b157-ca3ee57124c6

	measure 'Tempo di Approvazione' = ```
			
			VAR _issueKey =
			    SELECTEDVALUE('Jira Initiative Estimation'[issue_macro_business_initiative])
			
			VAR _dataInitialComala =
			    CALCULATE(
			        MIN('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Initial",
			        TREATAS(
			            VALUES('Jira Initiative Estimation'[issue_key]),
			            'Confluence Comala Issue Link'[issue_key]
			        ),
			        'Confluence Comala Issue Link'[issue_type] = "Initiative Estimation"
			    )
			
			VAR _dataInitialMBI =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        'MBI Transition Status'[issue_key] = _issueKey
			    )
			
			VAR _dataInitial =
			    COALESCE(_dataInitialComala, _dataInitialMBI)
			
			VAR _dataApproved =
			    CALCULATE(
			        MAX('Confluence Comala Activity'[Date Convertita]),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Approved",
			        TREATAS(
			            VALUES('Jira Initiative Estimation'[issue_key]),
			            'Confluence Comala Issue Link'[issue_key]
			        ),
			        'Confluence Comala Issue Link'[issue_type] = "Initiative Estimation"
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(_dataInitial)
			        && NOT ISBLANK(_dataApproved),
			    DATEDIFF(_dataInitial, _dataApproved, DAY)
			)
			
			```
		formatString: 0
		lineageTag: 1330a17f-f0f3-426a-96c4-ae21e08c8b75

		changedProperty = Name

	measure 'Data Ingresso Initial' = ```
			
