	column created_date =
			
			IF(
			    YEAR('Jira Initiative Estimation'[issue_created_date]) < 2026,
			    DATE(1999,01,01),
			    DATE(
			        YEAR('Jira Initiative Estimation'[issue_created_date]),
			        MONTH('Jira Initiative Estimation'[issue_created_date]),
			        DAY('Jira Initiative Estimation'[issue_created_date])
			    )
			)
		formatString: General Date
		lineageTag: e3134658-b586-4666-9c62-e362b328ee36
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Tempo della DU per HLD IE Colonna' =
			
			IF(
			    NOT ISBLANK([Data Stato Initial IE (Confluence)]) &&
			    NOT ISBLANK([Data Stato Approved IE (Confluence)]),
			    DATEDIFF(
			        [Data Stato Initial IE (Confluence)],
			        [Data Stato Approved IE (Confluence)],
			        DAY
			    ),
			    BLANK()
			)
		formatString: 0
		displayFolder: Documento Confluence
		lineageTag: 7f3d221f-d491-4c14-b961-070ea60c482b
		summarizeBy: sum

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Data Stato Approved IE (Confluence) Colonna'
		type: calculated
		displayFolder: Documento Confluence
		lineageTag: b3f2901a-bb6a-4bbd-a69e-333990268533
		summarizeBy: sum

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":"\nVAR _currentIssueKey =\n    'Jira Initiative Estimation'[issue_key]\n\nVAR _pageIDs =\n    CALCULATETABLE (\n        SELECTCOLUMNS (\n            'Confluence IE Pages',\n            \"pageid\", 'Confluence IE Pages'[pageid]\n        ),\n        FILTER (\n            ALL ( 'Confluence Comala Issue Link' ),\n            'Confluence Comala Issue Link'[issue_key] = _currentIssueKey\n        )\n    )\n\nVAR _result =\n    CALCULATE (\n        MAX ( 'Confluence Comala Activity'[Date Convertita] ),\n        FILTER (\n            ALL ( 'Confluence Comala Activity' ),\n            'Confluence Comala Activity'[page_id] IN _pageIDs\n                && 'Confluence Comala Activity'[Comala Stato Documento] = \"Approved\"\n        )\n    )\n\nRETURN\n    _result"}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = ```
				È stata rilevata una dipendenza circolare: Jira Initiative Estimation[Colonna 2], Jira Initiative Estimation[Tempo della DU per HLD IE Colonna], Jira Initiative Estimation[Colonna 2].
				
				```

	column 'IE Giorni nello stato 3'
		type: calculated
		lineageTag: 929917ca-e647-42a1-ad53-dcdaa10d28fa
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":"\nVAR CurrentIssue =\n    'Jira Initiative Estimation'[issue_key]\n\nVAR CurrentStatus =\n    'Jira Initiative Estimation'[issue_status]\n\nVAR UltimaEntrata =\n    CALCULATE (\n        MAX ( 'IE Transition Status'[transition_date] ),\n        FILTER (\n            ALL ( 'IE Transition Status' ),\n            'IE Transition Status'[issue_key] = CurrentIssue\n                && 'IE Transition Status'[to_status] = CurrentStatus\n        )\n    )\n\nVAR DataCreazione =\n    'Jira Initiative Estimation'[issue_created_date]\n\nVAR StartDateFinale =\n    IF (\n        CurrentStatus = \"Open\" || ISBLANK ( UltimaEntrata ),\n        DataCreazione,\n        UltimaEntrata\n    )\n\nRETURN\nIF (\n    NOT ISBLANK ( StartDateFinale ),\n    DATEDIFF ( StartDateFinale, TODAY (), DAY ),\n    BLANK ()\n)"}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = ```
				È stata rilevata una dipendenza circolare: Jira Initiative Estimation[Colonna 2], Jira Initiative Estimation[Tempo della DU per HLD IE Colonna], Jira Initiative Estimation[Colonna 2].
				
				```

	column 'URL MBI' = LOOKUPVALUE('Jira Macro Business Initiative'[URL], 'Jira Macro Business Initiative'[Issue key], 'Jira Initiative Estimation'[issue_macro_business_initiative])
		lineageTag: 239f5292-5b68-479c-ac56-507998d91f84
		dataCategory: WebUrl
		summarizeBy: none

		changedProperty = Name

		changedProperty = DataCategory

		annotation SummarizationSetBy = Automatic

	partition 'Jira Initiative Estimation' = entity
		mode: directQuery
		source
