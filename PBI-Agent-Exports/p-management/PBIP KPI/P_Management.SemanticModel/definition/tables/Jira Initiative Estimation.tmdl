	measure 'Media Tempo Fasi Documento' = ```
			
			AVERAGEX(
			    FILTER(
			        VALUES('Jira Initiative Estimation'[issue_key]),
			        NOT ISBLANK(CALCULATE([Tempo della DU per HLD IE]))
			            || NOT ISBLANK(CALCULATE([Tempo per approvazione HLD da Business IE]))
			            || NOT ISBLANK(CALCULATE([Tempo per approvazione HLD da DE IE]))
			            || NOT ISBLANK(CALCULATE([Tempo per Approvazione IC DU IE]))
			    ),
			    VAR T1 = CALCULATE([Tempo della DU per HLD IE])
			    VAR T2 = CALCULATE([Tempo per approvazione HLD da Business IE])
			    VAR T3 = CALCULATE([Tempo per approvazione HLD da DE IE])
			    VAR T4 = CALCULATE([Tempo per Approvazione IC DU IE])
			    VAR Somma = COALESCE(T1,0) + COALESCE(T2,0) + COALESCE(T3,0) + COALESCE(T4,0)
			    VAR Conteggio = 
			        (IF(NOT ISBLANK(T1) && T1<>0, 1, 0))
			        + (IF(NOT ISBLANK(T2) && T2<>0, 1, 0))
			        + (IF(NOT ISBLANK(T3) && T3<>0, 1, 0))
			        + (IF(NOT ISBLANK(T4) && T4<>0, 1, 0))
			    RETURN
			        IF(Conteggio > 0, DIVIDE(Somma, Conteggio))
			)
			```
		displayFolder: Documento Confluence\KPI Documento
		lineageTag: 418d7506-3888-47d9-bf81-d78fa46575bc

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Tempo per approvazione HLD da DE IE' =
			
			AVERAGEX(
			    FILTER(
			        'Jira Initiative Estimation',
			        'Jira Initiative Estimation'[issue_status] <> "Rejected"
			    ),
			    [Tempo per approvazione HLD da DE IE]
			)
		displayFolder: Documento Confluence\KPI Documento
		lineageTag: 6dc0c56a-e5af-4e35-b76f-14432c85f914

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Tempo per approvazione HLD da Business IE' =
			
			AVERAGEX(
			    FILTER(
			        'Jira Initiative Estimation',
			        'Jira Initiative Estimation'[issue_status] <> "Rejected"
			    ),
			    [Tempo per approvazione HLD da Business IE]
			
			)
		displayFolder: Documento Confluence\KPI Documento
		lineageTag: 6beb0069-0450-4104-9413-c2082b99bd1c

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Tempo per Approvazione IC DU IE' =
			
			AVERAGEX(
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                'Jira Initiative Estimation',
			                'Jira Initiative Estimation'[issue_key],
			                'Jira Initiative Estimation'[issue_status]
			            ),
			            "@Tempo", CALCULATE([Tempo per Approvazione IC DU IE])
			        ),
			        [issue_status] <> "Rejected" && NOT ISBLANK([@Tempo])
			    ),
			    [@Tempo]
			)
		displayFolder: Documento Confluence\KPI Documento
		lineageTag: 3cd0c93c-51b6-4d16-823c-7f80e277e62b

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivery Unit' = ```
			
			VAR _data1 = 
			    CALCULATE(
			        MIN('IE Transition Status'[transition_date]),
			        'IE Transition Status'[to_status] = "Waiting for Estimate"
			    )
			VAR data2 = 
			    CALCULATE(
			        MAX('IE Transition Status'[transition_date]),
			        'IE Transition Status'[to_status] = "Check Estimation"
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_data1) && NOT ISBLANK(data2),
			        DATEDIFF(_data1, data2, DAY)
			    )
			```
		formatString: 0
		displayFolder: Documento Confluence
		lineageTag: 4a886535-e985-4375-b3ad-9b5be408f23d

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'IE Giorni nello stato' =
			
			VAR currentIssue = SELECTEDVALUE('Jira Initiative Estimation'[issue_key])
			VAR currentStatus = SELECTEDVALUE('IE Transition Status'[to_status])
			
			VAR startDate =
			    CALCULATE(
			        MAX('IE Transition Status'[transition_date]),
			        ALLEXCEPT('IE Transition Status', 'IE Transition Status'[issue_key])
			    )
			
			VAR DataCreazioneOpen =
			    LOOKUPVALUE(
			        'Jira Initiative Estimation'[issue_created_date],
			        'Jira Initiative Estimation'[issue_key], currentIssue
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open" || ISBLANK(currentStatus),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
		formatString: 0
		lineageTag: 9d308c4b-ba23-47ee-a44e-d7d2d779fc93

		changedProperty = Name

	measure 'Data Ingresso IE' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Initiative Estimation'[issue_key])
			VAR StatoCorrente = SELECTEDVALUE('Jira Initiative Estimation'[issue_status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('IE Transition Status'[transition_date]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[issue_key] = IssueCorrente
			                && 'IE Transition Status'[to_status] = StatoCorrente
			                && 'IE Transition Status'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Initiative Estimation'[issue_created_date]),
			        'Jira Initiative Estimation'[issue_key] = IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open", //&& ISBLANK(DataDaTransizioni)
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		lineageTag: eb45a4ab-41d3-4191-bad6-250cfbaf8489

		changedProperty = Name

	measure 'DEBUG Contesto Gruppo' = SELECTEDVALUE ( 'APM'[DF_LEVEL_2] )
		lineageTag: ae677a0a-82cd-4426-9e82-3440ec49de48

		changedProperty = Name

	measure 'IE Flag Match Selezione' =
			
			VAR StatusSelezionato =
			    SELECTEDVALUE ( 'Workflow Fasi IE Semplificate'[Status] )
			
			VAR L1Selezionato =
			    SELECTEDVALUE ( 'APM'[DF_LEVEL_1] )
			
			VAR L2Selezionato =
			    SELECTEDVALUE ( 'APM'[DF_LEVEL_2] )
			
			VAR IssueStatusCorrente =
			    SELECTEDVALUE ( 'Jira Initiative Estimation'[issue_status] )
			
			VAR IssueL1Corrente =
			    SELECTEDVALUE ( 'APM'[DF_LEVEL_1] )
			
			VAR IssueL2Corrente =
			    SELECTEDVALUE ( 'APM'[DF_LEVEL_2] )
			
			RETURN
			IF (
			    ( ISBLANK ( StatusSelezionato ) || StatusSelezionato = IssueStatusCorrente )
			        && ( ISBLANK ( L1Selezionato ) || L1Selezionato = IssueL1Corrente )
			        && ( ISBLANK ( L2Selezionato ) || L2Selezionato = IssueL2Corrente )
			        && IssueStatusCorrente IN { "Open", "Check Estimation", "Waiting for Estimate", "Estimation Approval" },
			    1,
			    0
			)
		formatString: 0
		lineageTag: 51d60752-c5b4-4865-b7a6-f2fcb650097a

		changedProperty = Name

