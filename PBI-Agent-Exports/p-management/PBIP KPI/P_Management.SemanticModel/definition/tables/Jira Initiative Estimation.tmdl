	measure 'Media Tempo DU per HLD IE' =
			
			AVERAGEX(
			    FILTER(
			        'Jira Initiative Estimation',
			        'Jira Initiative Estimation'[issue_status] <> "Rejected"
			    ),
			    [Tempo della DU per HLD IE]
