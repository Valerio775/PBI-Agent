			        ),
			        'Confluence Comala Issue Link'[issue_type] = "Initiative Estimation"
			    )
			VAR IssueKey = SELECTEDVALUE('Jira Initiative Estimation'[issue_macro_business_initiative])
			VAR TechEvalDate = 
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        'MBI Transition Status'[issue_key] = IssueKey,
			        'MBI Transition Status'[to_status] = "High-Level Functional Requirement"
			    )
			RETURN
			    IF(
			        NOT ISBLANK(InitialDate),
			        InitialDate,
			        TechEvalDate
			    )
			```
