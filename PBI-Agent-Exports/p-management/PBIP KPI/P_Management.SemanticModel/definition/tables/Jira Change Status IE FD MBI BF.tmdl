	column 'Giorni da In Progress a Completed' = ```
			
			VAR StartDate =
			    CALCULATE (
			        MAX ( 'Jira Change Status IE FD MBI BF'[transition_date] ),
			        ALLEXCEPT (
			            'Jira Change Status IE FD MBI BF',
			            'Jira Change Status IE FD MBI BF'[issue_key]
			        ),
			        'Jira Change Status IE FD MBI BF'[to_status] = "Open"
			    )
			 
			RETURN
			IF (
			    'Jira Change Status IE FD MBI BF'[to_status] = "High-Level Functional Requirement"
			        && NOT ISBLANK ( StartDate ),
			    'Jira Change Status IE FD MBI BF'[transition_date] - StartDate,
			    BLANK ()
			)
			```
		dataType: int64
		lineageTag: 75eb1427-9c94-48c1-8cd4-bd11f84607c0
		summarizeBy: sum

