	column GDS_Line_HUB
		lineageTag: b7d0d296-8f47-4dfb-9ebe-858cbe8ccaac
		summarizeBy: none
		isNameInferred
		sourceColumn: Jira Project List[GDS_Line_HUB]

		annotation SummarizationSetBy = Automatic

	partition Filtri = calculated
		mode: import
		source =
				
				VAR DataInizio = DATE(2025, 1, 1)
				VAR DataFine =
				    MAXX(ALL('Jira Issue Detail'), 'Jira Issue Detail'[created_date])
				VAR CalendarioBase =
				    ADDCOLUMNS(
				        CALENDAR(DataInizio, DataFine),
				        "Anno", YEAR([Date]),
				        "NumeroMese", MONTH([Date]),
				        "AnnoMese", FORMAT([Date], "YYYY-MM"),
				        "Mese", FORMAT([Date], "MMM", "en-US"),
				        "Mese_No", MONTH([Date])
				    )
				VAR GDS =
				    SUMMARIZE(
				        'Jira Project List',
				        'Jira Project List'[GDS_Line_HUB]
				    )
				
				RETURN
				CROSSJOIN(
				    CalendarioBase,
				    GDS
				)

	annotation PBI_Id = 89b8c9b1a8c141dda9928e3d02c7bd60

