	column 'Giorni in Stato BF Journey' = ```
			
			VAR issueKey = 'BF Transition Status Confluence'[issue_key] //[Data Ingresso BF Confluence]
			VAR currentStatus = 
			    LOOKUPVALUE(
			        'Jira Business Feature'[Issue status],
			        'Jira Business Feature'[Issue key], issueKey
			    )
			
			VAR startDate =
			    CALCULATE(
			        MIN('BF Transition Status Confluence'[transition_date]),
			        FILTER(
			            ALL('BF Transition Status Confluence'),
			            'BF Transition Status Confluence'[issue_key] = issueKey
			                && 'BF Transition Status Confluence'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen = 
			    LOOKUPVALUE(
			        'Jira Business Feature'[Issue created date],
			        'Jira Business Feature'[Issue key], issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open" && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
			```
		displayFolder: Journey
		lineageTag: a0f6c358-7000-4ec5-a52d-a969d763f417
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FD Giorni nello stato Journey' =
			
			VAR currentIssue = 'FD Transition Status Confluence'[issue_key]
			VAR currentStatus = 'FD Transition Status Confluence'[to_status]
			
			VAR startDate =
			    CALCULATE(
			        MIN('FD Transition Status Confluence'[transition_date]),
			        ALLEXCEPT('FD Transition Status Confluence', 'FD Transition Status Confluence'[issue_key], 'FD Transition Status Confluence'[to_status])
			    )
			
			VAR DataCreazioneOpen =
			    LOOKUPVALUE(
			        'Jira Feature Delivery'[Issue created date],
			        'Jira Feature Delivery'[Issue Key [Issue]]], currentIssue
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open",// && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
		formatString: 0
		displayFolder: Journey
		lineageTag: 88e40fa1-867f-4f07-bd52-18fec4df5063
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'FD Transition Status Confluence' = calculated
		mode: import
		source = FILTER('Jira Change Status IE FD MBI BF', 'Jira Change Status IE FD MBI BF'[issue_type] = "Feature Delivery")

	annotation PBI_Id = d04a6969cc3547868000a92bf42b7caf

