table 'FD Transition Status Confluence'
	lineageTag: 8c4bc0f3-0207-4407-a286-347e267d21c3

	measure 'FD Data Ingresso Journey' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Feature Delivery'[Issue Key [Issue]]])
			VAR StatoCorrente = SELECTEDVALUE('Jira Feature Delivery'[Issue status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('FD Transition Status Confluence'[transition_date]),
			        FILTER(
			            ALL('FD Transition Status Confluence'),
			            'FD Transition Status Confluence'[issue_key] = IssueCorrente
			                && 'FD Transition Status Confluence'[to_status] = StatoCorrente
			                && 'FD Transition Status Confluence'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Feature Delivery'[Issue created date]),
			        'Jira Feature Delivery'[Issue Key [Issue]]] = IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open",// && ISBLANK(DataDaTransizioni),
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Journey
		lineageTag: 8014db45-679a-4018-a3ac-63ef8327a63f

	measure 'FD conteggio giorni Journey' =
			
			
			VAR issueKey = SELECTEDVALUE('Jira Feature Delivery'[Issue Key [Issue]]])
			VAR currentStatus = SELECTEDVALUE('Jira Feature Delivery'[Issue status])
			
			VAR startDate =
			    CALCULATE(
			        MIN('FD Transition Status Confluence'[transition_date]),
			        FILTER(
			            ALL('FD Transition Status Confluence'),
			            'FD Transition Status Confluence'[issue_key] = issueKey
			                && 'FD Transition Status Confluence'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Feature Delivery'[Issue created date]),
			        REMOVEFILTERS('Jira Feature Delivery'),
			        'Jira Feature Delivery'[Issue Key [Issue]]] = issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open",
			        DataCreazioneOpen,
			        startDate
			    )
			
			VAR endDateFinale =
			    IF(
			        currentStatus = "Release Completed",
			        startDate,   // data di ingresso in Released = fine conteggio
			        TODAY()
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, endDateFinale, DAY),
			    BLANK()
			)
		formatString: 0
		displayFolder: Journey
		lineageTag: 3ae8af21-fa14-4bda-ab43-13e341434d14

	measure 'FD Media giorni in stato Journey' =
			
			AVERAGEX(
			    VALUES('Jira Feature Delivery'[Issue Key [Issue]]]),
			    CALCULATE(MIN('FD Transition Status Confluence'[FD Giorni nello stato Journey]))
			)
		displayFolder: Journey
		lineageTag: d8d32e5b-e56f-434e-af36-3cbb91d32338

		annotation PBI_FormatHint = {"isGeneralNumber":true}

