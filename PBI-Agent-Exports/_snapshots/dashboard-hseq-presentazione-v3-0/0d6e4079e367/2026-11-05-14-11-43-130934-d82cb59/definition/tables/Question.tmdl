	column Description_ES = ```
			
			VAR txt = 'Question'[description]
			VAR Clean = SUBSTITUTE(txt, """}", "§END§")     -- rimpiazza '}' chiusura oggetto
			VAR StartPos = FIND("""ES""", Clean, 1, -1)
			VAR ValueStart = FIND("""value"": """, Clean, StartPos, -1) + LEN("""value"": """)
			VAR ValueEnd = FIND("§END§", Clean, ValueStart, -1)
			RETURN MID(Clean, ValueStart, ValueEnd - ValueStart)
			
			```
		lineageTag: a3fa509f-8efc-4241-adc2-6969dc99c08e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Testo_tra_parentesi = ```
			
			VAR PosInizio = SEARCH("[", 'Question'[Description_ES], , 0)
			VAR PosFine   = SEARCH("]", 'Question'[Description_ES], , 0)
			RETURN
			IF(
			    PosInizio > 0 && PosFine > PosInizio,
			    MID(
			        'Question'[Description_ES],
			        PosInizio + 1,
			        PosFine - PosInizio - 1
			    ),
			    BLANK()
			)
			
			```
		lineageTag: f1a05dcf-f933-440c-ba05-23573de86c0a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column priority
