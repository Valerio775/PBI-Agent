		level NumeroMese
			lineageTag: d768b4a3-d433-458d-a8f7-2e0da5429503
			column: NumeroMese

	partition Calendario_MeseAnno = calculated
		mode: import
		source =
				
				VAR DataInizio = DATE(2025, 1, 1)
				VAR DataFine   = MAXX(ALL(Update_time), Update_time[last_update])
				RETURN
				SUMMARIZE(
				    CALENDAR(DataInizio, DataFine),
				    [Date],
				    "Anno", CONVERT(YEAR([Date]),STRING),
				    "NumeroMese", CONVERT(MONTH([Date]),STRING),
				    "AnnoMese", FORMAT([Date], "YYYY-MM"),
				    "Mese", FORMAT([Date], "MMM", "en-US"),
				    "Mese_No", MONTH([Date])
				)

	annotation PBI_Id = 759e7a04238748c1a19cd89fc710c14c

