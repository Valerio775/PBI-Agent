	partition Inspection = m
		mode: import
		source = ```
				let
				    Origine = Databricks.Catalogs(origine, warehouses, [Catalog = "", Database = ""]),
				    #"dpegpl-hseq-dev_Database" = Origine{[Name=database,Kind="Database"]}[Data],
				    hseq4all_gl_gld_Schema = #"dpegpl-hseq-dev_Database"{[Name=schema,Kind="Schema"]}[Data],
				    finding_View = hseq4all_gl_gld_Schema{[Name="inspection",Kind="View"]}[Data]
				 
				in finding_View
				```

