	column execution_date_formatted = LEFT(Inspection[execution_date], 10)
		dataType: dateTime
		formatString: Short Date
		lineageTag: 34ccbdfb-5df1-441d-ba8c-23a5d5173bee
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column execution_date_fixed =
			
			IF (
			    ISBLANK ( 'Inspection'[execution_date] ),
			    DATE ( 2024, 12, 31 ),
			    'Inspection'[execution_date]
			)
		formatString: Short Date
		lineageTag: 71cdc5ef-0640-4aa9-8e7d-29e806bed0df
		summarizeBy: none

		variation Variazione
			isDefault
			relationship: bfba1996-d4ba-4997-b964-5f15b23dcaa2
			defaultHierarchy: LocalDateTable_5893cf15-7706-444e-8f75-1ab892e81ca1.'Gerarchia data'

		annotation SummarizationSetBy = Automatic

	column Etichetta_Mese_Custom = ```
			
			//ASSE X grafico Inspections:genera una etichetta basata sulla data ispezione. Se anno=2024 viene mostrata la dicitura "ispezioni in bozza" 
			IF (
			    'Inspection'[execution_date_fixed] = DATE (2024, 12, 31),
			    "Ispezioni in bozza",
			    FORMAT ( 'Inspection'[execution_date_fixed], "MMMM", "it-IT" )
			)
			```
		lineageTag: 2004b0da-df1a-44b0-93c1-cb578985bf31
		summarizeBy: none
		sortByColumn: Ordine_Mesi

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Ordine_Mesi =
			
			//Crea un valore numerico nel formato YYYYMM per ordinare correttamente i mesi in ordine cronologico quando l’etichetta del mese è testuale
			YEAR('Inspection'[execution_date_fixed]) * 100 + MONTH('Inspection'[execution_date_fixed])
		formatString: 0
		lineageTag: ded8720b-1c94-43ef-8585-a7dc4f21148f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

