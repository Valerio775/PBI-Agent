table Inspection
	lineageTag: 8522b3d9-6308-487d-a070-5da644585097

	measure 'Inspection YTD' = ```
			
			TOTALYTD(
			    SUM(Inspection[id]),
			    Calendario[Date]
			)
			
			```
		formatString: 0
		lineageTag: f32620ac-3838-4e4c-bf8d-9c554386698f

	measure 'Totale Ispezioni' =
			//Totale Ispezioni conta tutto
			var conteggio = COUNTROWS(Inspection)
			return COALESCE(conteggio, 0)
		formatString: 0
		lineageTag: 0588821b-e573-4982-a4b7-be961266a126

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Conteggio Inspection' = COUNT('inspection'[id])
		formatString: 0
		lineageTag: 33f0e2c8-718b-4fe4-aefb-04f701cb7075

	measure 'Numero Ispezioni' = ```
			
			// ASSE Y grafico Inspections: conta solo ciò che rientra nel periodo selezionato più le ispezioni di backlog
			VAR SlicerMin = MIN('Calendario'[DateJoin])
			VAR SlicerMax = MAX('Calendario'[DateJoin])
			 
			VAR ConteggioFisico = COUNTROWS(Inspection)
			 
			VAR IsBacklog = SELECTEDVALUE('Inspection'[execution_date_fixed]) = DATE(2024, 12, 31)
			 
			RETURN
			IF(
			    IsBacklog,
			    ConteggioFisico,
			    IF(
			        MIN('Inspection'[execution_date_fixed]) <= SlicerMax &&
			        MAX('Inspection'[execution_date_fixed]) >= SlicerMin,
			        COALESCE(ConteggioFisico, 0),
			        BLANK()
			    )
			)
			```
		formatString: 0
		lineageTag: 1c4dfd3d-3bac-447d-8b62-574b48fed752

	measure 'Ispezioni Trend Annuale' =
			VAR Conteggio = COUNTROWS(Inspection)
			RETURN IF(Conteggio = 0, BLANK(), Conteggio)
		formatString: 0
		displayFolder: Contractor
		lineageTag: 6c40b07d-ef96-4baf-9086-63e53fc28be3

