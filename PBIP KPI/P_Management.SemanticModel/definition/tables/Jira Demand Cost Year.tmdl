	column Local_cost = ```
			
			VAR RawText =
			    'Jira Demand Cost Year'[Issue Local Cost Currency]
			
			VAR CleanText =  SUBSTITUTE(SUBSTITUTE (RawText, ",", ""), ".", ",")
			
			RETURN
			    IF (
			        CleanText = "" || ISBLANK ( CleanText ),
			        0,
			        VALUE ( CleanText )
			    )
			
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: b0899bd8-8f64-4171-af4a-2f7921e806fa
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"it-IT"}

	column Scenario = RIGHT('Jira Demand Cost Year'[Issue Scenario Name], 2)
		lineageTag: edead559-51d3-4437-8b93-4c9f5cfdaa53
