	measure From_IE = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _X = PATHITEM(_StringaPath, 1)
			
			VAR _DataMinimaX = 
			    CALCULATE(
			        MIN('IE Transition Status'[transition_date]),
			        ALLEXCEPT('IE Transition Status', 'IE Transition Status'[issue_key]),
			        'IE Transition Status'[from_status] = _X 
			    )
			
			RETURN
			    _DataMinimaX
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Macro Business Initiative
		lineageTag: 16d57ada-4d11-4d07-8f69-984ecfc0523a

	measure ToStatus_IE = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _Y = PATHITEM(_StringaPath, 2) -- Lo stato di arrivo (es. Estimation Done)
			
			-- Calcoliamo la data massima filtrando per l'ingresso nello stato Y
			VAR _DataMassimaY = 
			    CALCULATE(
			        MAX('IE Transition Status'[transition_date]),
			        ALLEXCEPT('IE Transition Status', 'IE Transition Status'[issue_key]),
			        'IE Transition Status'[to_status] = _Y,
			        'IE Transition Status'[from_status] <> _Y -- Evita di prendere aggiornamenti mentre è già in Y
			    )
			
			RETURN
			    _DataMassimaY
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Macro Business Initiative
		lineageTag: c09c3077-f4f2-4d4e-a084-fed2ba058a13

