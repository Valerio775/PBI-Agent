	measure 'DEBUG num KPI1' = ```
			
			
			//
			// ===== JMBI =====
			//
			
			VAR T_JMBI_ICT =
			CALCULATETABLE(
			    SELECTCOLUMNS(
			        'Jira Macro Business Initiative',
			        "IM_norm", 'Jira Macro Business Initiative'[Issue Investment Memo]
			    ),
			    'Jira Project List'[Project_Status] <> "Demo Project"
			--    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Macro Business Initiative'[GDS_line_prj])
			--    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Macro Business Initiative'[Factory_Chapter]) serve capire il secondo livello
			)
			
			//
			// ===== Lista IM approvati =====
			//
			
			VAR tab_ICT =
			CALCULATETABLE(
			    VALUES('Jira Demand'[Issue Investment Memo]),
			    'Jira Investment Memo'[Issue_status] = "Approved",
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Business Need'[1st richiedente]),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Business Need'[2nd richiedente])
			)
			
			var tabella_ICT = 
			DISTINCT(INTERSECT(T_JMBI_ICT, tab_ICT))
			
			RETURN
			COALESCE(COUNTROWS(tabella_ICT),0)
			```
		formatString: 0
		displayFolder: Jira Adoption
		lineageTag: 3114e5dd-45d7-45bd-88b1-a505aecbe806

	measure 'DEBUG den KPI1' = ```
			
			
			VAR calcolo_filtrato = 
			CALCULATE(
			    DISTINCTCOUNT('Jira Demand'[Issue Investment Memo]),
			    'Jira Investment Memo'[Issue_status] = "Approved",
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Business Need'[1st richiedente]),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Business Need'[2nd richiedente])
			)
			
			
			
			RETURN 
			COALESCE(calcolo_filtrato, 0 )
			```
		formatString: 0
		displayFolder: Jira Adoption
		lineageTag: 6619d79a-58ee-4f14-b5d2-0681ec74b6e7

	measure 'DEBUG num KPI2' =
			
			
			VAR T_JMBI_ICT =
			CALCULATETABLE(
			    SELECTCOLUMNS(
			        'Jira Macro Business Initiative',
			        "IM_norm", 'Jira Macro Business Initiative'[Issue Investment Memo]
			    ),
			    'Jira Project List'[Project_Status] <> "Demo Project",
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Macro Business Initiative'[Projectrak GDS Line]),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Macro Business Initiative'[Projectrak Factory - Chapter])
			)
			
			//
			// ===== Lista IM approvati =====
			//
			
			VAR tab_ICT =
			CALCULATETABLE(
			    SELECTCOLUMNS(
			        'Jira Demand',
			        "IM_norm", 'Jira Demand'[Issue Investment Memo]
			    ),
			    KEEPFILTERS('Jira Investment Memo'[Issue_status] = "Approved"),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Business Need'[1st richiedente]),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Business Need'[2nd richiedente])
			)
			
			VAR tabella_ICT  = DISTINCT(INTERSECT(T_JMBI_ICT, tab_ICT))
			
			/* ===== Totale costi ===== */
			
			VAR TotaleCosti_ICT =
			    CALCULATE (
			        SUM ( 'Jira Demand'[Total Cost] ),
			        TREATAS ( tabella_ICT, 'Jira Investment Memo'[IM_norm] )
			    )
			
			RETURN
			COALESCE ( TotaleCosti_ICT, 0 )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Jira Adoption
		lineageTag: d0ada9da-e1c3-47cd-a7d4-bed58b9bb69b

		annotation PBI_FormatHint = {"currencyCulture":"it-IT"}

	measure 'DEBUG den KPI2' = ```
			
			VAR _IM_validi =
			CALCULATETABLE(
			    VALUES('Jira Demand'[Issue Investment Memo]),
			    KEEPFILTERS('Jira Investment Memo'[Issue_status] = "Approved"),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_1]), 'Jira Business Need'[1st richiedente]),
			    TREATAS(VALUES('GDS_Line'[ICT_lvl_2]), 'Jira Business Need'[2nd richiedente])
			)
			
			var calcolo_filtrato =
			CALCULATE(
			    SUM('Jira Demand'[Total Cost]),
			    // Restringe la somma ai soli IM validi
			    KEEPFILTERS(
			        TREATAS(
			            _IM_validi,
			            'Jira Demand'[Issue Investment Memo]
			        )
			    )
			)
			
			RETURN 
			COALESCE(calcolo_filtrato, 0 )
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Jira Adoption
		lineageTag: 79848c58-7846-456a-8425-b1d4545114ca

		annotation PBI_FormatHint = {"currencyCulture":"it-IT"}

	measure 'DEBUG num KPI3' =
			
			VAR Features_Denom =
			    CALCULATETABLE(
			        DISTINCT(  'Jira Feature Delivery'[Issue Key [Issue]]] ),
			        'Jira Feature Delivery'[Issue status] IN {
			            "In Progress", "Ready for UAT", "Completed",
			            "Release Completed", "UAT Passed"
			        },
			        'Jira Feature Delivery'[Issue Initiative Type] = "Project",
			        'Jira Business Feature'[Projectrak Project Status] <> "Demo Project"
			    )
			
			VAR Features_Epic =
			    CALCULATETABLE(
			        DISTINCT( 'Jira Epic'[feature_delivery] ),
			        NOT ISBLANK('Jira Epic'[feature_delivery]),
			        'Jira Epic'[feature_delivery] <> "",
			        'Jira Project List'[Project_Status] <> "Demo Project"
			    )
			
			VAR ValidFeatures =
			    INTERSECT( Features_Epic, Features_Denom )
			
			VAR Result =
			    CALCULATE(
			        COUNTROWS( ValidFeatures ),
			        USERELATIONSHIP(
			            'Jira Issue Detail'[epiclink],
			            'Jira Epic'[issue_key]
			        ),
			        KEEPFILTERS(
			            'Jira Issue Detail'[issue_type_name]
			                IN { "Task", "Milestone", "Story" }
			        )
			    )
			
			RETURN
			    COALESCE(Result, 0)
		formatString: 0
		displayFolder: Jira Adoption
		lineageTag: c9623682-17b9-4a2e-a387-6bc819f0a88e

	measure 'DEBUG den KPI3' =
			
			
			var calcolo = -- conteggio le feature delivery con stato in progress o superiore
			    CALCULATE(
			        COUNTROWS('Jira Feature Delivery'),
			        'Jira Feature Delivery'[Issue status] in {"In Progress", "Ready for UAT", "Completed", "Release Completed", "UAT Passed"} &&
			        'Jira Feature Delivery'[Issue Initiative Type] = "Project",
			        'Jira Project List'[Project_Status] <> "Demo Project",
			        'Jira Business Feature'[Projectrak Project Status] <> "Demo Project"
			        -- TREATAS(ProgettiSelezionati,'Jira Feature Delivery'[GDS_line_prj]) -- sembra non esserci nessuna GDS Line valorizzata
			    )
			
			RETURN COALESCE(calcolo, 0 )
		formatString: 0
		displayFolder: Jira Adoption
		lineageTag: c5c31879-72f7-4dfd-976a-9a380874ca4e

