	partition Misure = m
		mode: import
		source =
				let
				    Origine = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Blind = _t]),
				    #"Modificato tipo" = Table.TransformColumnTypes(Origine,{{"Blind", type text}})
