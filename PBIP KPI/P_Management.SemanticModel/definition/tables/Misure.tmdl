	measure From_BF = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _X = TRIM(PATHITEM(_StringaPath, 1)) -- Lo stato di partenza (es. Tech Evaluation)
			
			
			
			-- Calcoliamo la data minima filtrando per lo stato X
			VAR _DataMinimaX = 
			    CALCULATE(
			        MIN('BF Transition Status'[transition_date]),
			        ALLEXCEPT('BF Transition Status', 'BF Transition Status'[issue_key]),
			        'BF Transition Status'[to_status] = _X,
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			RETURN
			    _DataMinimaX
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Business Feature
		lineageTag: 662faaeb-354f-478f-9093-4b543cc2463a

	measure ToStatus_BF = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _Y = TRIM(PATHITEM(_StringaPath, 2)) -- Lo stato di arrivo (es. Estimation Done)
			//VAR _Y = TRIM(PATHITEM(_StringaPath, 1)) -- Prende il PRIMO elemento (In Progress)
			/*
			VAR _Y = 
			    IF(
			        _Scelta = "In Progress to Ready for UAT ", 
			        TRIM(PATHITEM(_StringaPath, 1)), -- Prende "In Progress"
			        PATHITEM(_StringaPath, 2)  -- Per tutti gli altri prende lo stato di arrivo
			    )
			*/
			
			-- Calcoliamo la data massima filtrando per l'ingresso nello stato Y
			VAR _DataMassimaY = 
			    CALCULATE(
			        MAX('BF Transition Status'[transition_date]),
			        ALLEXCEPT('BF Transition Status', 'BF Transition Status'[issue_key]),
			        'BF Transition Status'[to_status] = _Y,
			        //'BF Transition Status'[from_status] <> _Y,
			        'Jira Project List 2'[Project_Status] <> "Demo Project"
			    )
			
			RETURN
			    _DataMassimaY
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Business Feature
		lineageTag: 6b4d4b00-6040-4a01-b9bc-42f85e6c54f4

	measure 'AVG InProgress_ConfirmReleased' = ```
			
			VAR TabellaUltimoStato = 
			    SUMMARIZE(
			        FILTER(
			            'BF Transition Status', 
			            NOT ISBLANK('BF Transition Status'[Lead Time - InProgress_ConfirmReleased])
			        ),
			        'BF Transition Status'[issue_key],
			        "UltimoValoreGiorni", MAX('BF Transition Status'[Lead Time - InProgress_ConfirmReleased])
			    )
			RETURN
			AVERAGEX(
			    TabellaUltimoStato, 
			    [UltimoValoreGiorni]
			)
			```
