	measure 'AVG OpenApproved' = ```
			
			VAR TabellaUltimoStato = 
			    SUMMARIZE(
			        FILTER(
			            'MBI Transition Status', 
			            NOT ISBLANK('MBI Transition Status'[Lead Time - OpenApproved])
			        ),
			        'MBI Transition Status'[issue_key],
			        "UltimoValoreGiorni", MAX('MBI Transition Status'[Lead Time - OpenApproved])
			    )
