	measure ToStatus_MBI = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _Y = PATHITEM(_StringaPath, 2) -- Lo stato di arrivo (es. Estimation Done)
			
			-- Calcoliamo la data massima filtrando per l'ingresso nello stato Y
			VAR _DataMassimaY = 
			    CALCULATE(
			        MAX('MBI Transition Status'[transition_date]),
			        ALLEXCEPT('MBI Transition Status', 'MBI Transition Status'[issue_key]),
			        'MBI Transition Status'[to_status] = _Y,
			        'MBI Transition Status'[from_status] <> _Y -- Evita di prendere aggiornamenti mentre è già in Y
			    )
			
			RETURN
			    _DataMassimaY
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Macro Business Initiative
		lineageTag: c9869785-68d2-44cc-9332-2edf615f2789

	measure From_MBI = ```
			
			VAR _Scelta = SELECTEDVALUE(Filtri_grafici_MBI_IE[Misure])
			VAR _StringaPath = SUBSTITUTE(_Scelta, " to ", "|")
			VAR _X = PATHITEM(_StringaPath, 1) -- Lo stato di partenza (es. Tech Evaluation)
			
			-- Calcoliamo la data minima filtrando per lo stato X
			VAR _DataMinimaX = 
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        ALLEXCEPT('MBI Transition Status', 'MBI Transition Status'[issue_key]),
			        'MBI Transition Status'[from_status] = _X  -- Cerca il primo ingresso in X
			    )
			
			RETURN
			    _DataMinimaX
			```
		formatString: Short Date
		displayFolder: Quantitative / Generic\Macro Business Initiative
		lineageTag: 0cae5551-eace-424c-b1fe-896accee5c24

