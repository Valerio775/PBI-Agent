	measure 'Media Rework per Stato' = ```
			
			VAR OrdineSelezionato = MAX('Workflow Fasi MBI 2'[OrdineFase])
			
			VAR RigheRework =
			    FILTER(
			        ALL('MBI Transition Status'),
			        NOT ISBLANK('MBI Transition Status'[OrdineFrom])
			        && NOT ISBLANK('MBI Transition Status'[OrdineTo])
			        && 'MBI Transition Status'[OrdineTo] < 'MBI Transition Status'[OrdineFrom]
			        && NOT ISBLANK(OrdineSelezionato)
			        && 'MBI Transition Status'[OrdineFrom] = OrdineSelezionato
			        && NOT ISBLANK(
			            CALCULATE(
			                MIN('MBI Transition Status'[transition_date]),
			                FILTER(
			                    ALL('MBI Transition Status'),
			                    'MBI Transition Status'[issue_key] = EARLIER('MBI Transition Status'[issue_key])
			                    && 'MBI Transition Status'[transition_date] > EARLIER('MBI Transition Status'[transition_date])
			                    && 'MBI Transition Status'[to_status] = EARLIER('MBI Transition Status'[from_status])
			                    && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			                )
			            )
			        )
			    )
			
			VAR TotaleEpisodi = COUNTROWS(RigheRework)
			
			VAR IssueDistinte = 
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(RigheRework, "issue_key", 'MBI Transition Status'[issue_key])
			        )
			    )
			
			RETURN
			DIVIDE(TotaleEpisodi, IssueDistinte)
			```
