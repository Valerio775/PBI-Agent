table 'MBI Transition Status'
	lineageTag: 5b7a3cec-2f54-43e3-9c1e-8af853122bf0

	measure 'Giorni in Stato' = ```
			
			VAR issueKey = SELECTEDVALUE('Jira Macro Business Initiative'[Issue key])
			VAR currentStatus = SELECTEDVALUE('Jira Macro Business Initiative'[Issue status])
			
			VAR startDate =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = issueKey
			                && 'MBI Transition Status'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Macro Business Initiative'[Issue created date]),
			        REMOVEFILTERS('Jira Macro Business Initiative'),
			        'Jira Macro Business Initiative'[Issue key] = issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open" && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF( 
			    currentStatus = "Approved", 
			    0,
			    IF (
			        NOT ISBLANK(startDateFinale),
			        DATEDIFF(startDateFinale, TODAY(), DAY),
			        BLANK()
			    )
			)
			```
		formatString: 0
		displayFolder: Grafico 1
		lineageTag: 08fb3a31-9199-419d-aa52-9fe05c2eea42

	measure 'Media per Stato' =
			
			AVERAGEX(
			    VALUES('MBI Transition Status'[issue_key]),
			    CALCULATE(MIN('MBI Transition Status'[Giorni_In_Stato_Colonna]))
			)
		displayFolder: Grafico 1
		lineageTag: 60dfc512-7437-48ef-8fbf-a977a8a58ab2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Ingresso' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Macro Business Initiative'[Issue key])
			VAR StatoCorrente = SELECTEDVALUE('Jira Macro Business Initiative'[Issue status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = IssueCorrente
			                && 'MBI Transition Status'[to_status] = StatoCorrente
			                && 'MBI Transition Status'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Macro Business Initiative'[Issue created date]),
			        'Jira Macro Business Initiative'[Issue key] = IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open", //&& ISBLANK(DataDaTransizioni)
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Grafico 1
		lineageTag: dd81653b-67cf-4351-af37-4913aa04b03b

	measure 'Conteggio Pass-Through' =
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi MBI 2'[Status], "Open")
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('MBI Transition Status'),
			                'MBI Transition Status'[from_status] IN StatiDellaFase
			                    && NOT('MBI Transition Status'[to_status] IN StatiDellaFase)
			                    && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'MBI Transition Status'[issue_key],
			            "iu_data", 'MBI Transition Status'[transition_date]
			        )
			    )
			
			RETURN
			IF(
			    IsOpen,
			    -- Per Open: conta tutte le issue che hanno almeno una transizione di uscita dalla fase
			    COUNTROWS(
			        CALCULATETABLE(
			            VALUES('MBI Transition Status'[issue_key]),
			            FILTER(
			                ALL('MBI Transition Status'),
			                'MBI Transition Status'[from_status] IN StatiDellaFase
			                && NOT('MBI Transition Status'[to_status] IN StatiDellaFase)
			                && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			            )
			        )
			    ),
			    -- Per tutti gli altri stati: logica originale con coppia completa
			    VAR TransizioniEntrata =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL('MBI Transition Status'),
			                    'MBI Transition Status'[to_status] IN StatiDellaFase
			                ),
			                "ie_issue_key", 'MBI Transition Status'[issue_key],
			                "ie_data", 'MBI Transition Status'[transition_date]
			            )
			        )
			    VAR IssueUscite =
			        CALCULATETABLE(
			            VALUES('MBI Transition Status'[issue_key]),
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES('MBI Transition Status'[issue_key]),
			                    "HasCoppiaCompleta",
			                    VAR currentKey = 'MBI Transition Status'[issue_key]
			                    VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = currentKey)
			                    VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = currentKey)
			                    RETURN
			                        COUNTROWS(
			                            FILTER(
			                                entrateIssue,
			                                VAR dataEntrata = [ie_data]
			                                RETURN
			                                    COUNTROWS(
			                                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                                    ) > 0
			                            )
			                        ) > 0
			                ),
			                [HasCoppiaCompleta] = TRUE()
			            )
			        )
			    RETURN
			    CALCULATE(
			        DISTINCTCOUNT('MBI Transition Status'[issue_key]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[to_status] IN StatiDellaFase
			            && 'MBI Transition Status'[issue_key] IN IssueUscite
			        )
			    )
			)
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 72b09e9f-bff4-43a9-8657-44667f0ff772

	measure 'DEBUG Giorni Per Issue' =
			
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			
			VAR statiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR primaEntrata =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = issueKey
			                && 'MBI Transition Status'[to_status] IN statiDellaFase
			        )
			    )
			
			VAR ultimaUscita =
			    CALCULATE(
			        MAX('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = issueKey
			                && 'MBI Transition Status'[from_status] IN statiDellaFase
			        )
			    )
			
			VAR giorni =
			    IF(
			        NOT ISBLANK(primaEntrata) && NOT ISBLANK(ultimaUscita),
			        DATEDIFF(primaEntrata, ultimaUscita, DAY),
			        0
			    )
			
			RETURN IF(giorni > 0, giorni, 0)
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 11023a7e-3be4-4913-8888-7be14c1a5999

	measure 'DEBUG Giorni per Issue Open' =
			
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			
			VAR dataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Macro Business Initiative'[Issue Created Date Formatted]),
			        REMOVEFILTERS('Jira Macro Business Initiative'),
			        'Jira Macro Business Initiative'[Issue key] = issueKey
			    )
			
			VAR dataUscitaOpen =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = issueKey
			                && 'MBI Transition Status'[from_status] = "Open"
			        )
			    )
			
			VAR giorni =
			    IF(
			        NOT ISBLANK(dataCreazioneOpen) && NOT ISBLANK(dataUscitaOpen),
			        IF(
			            DATEDIFF(dataCreazioneOpen, dataUscitaOpen, DAY) < 0,
			            0,
			            DATEDIFF(dataCreazioneOpen, dataUscitaOpen, DAY)
			        ),
			        BLANK()
			    )
			
			RETURN IF(giorni > 0, giorni, BLANK())
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 7a82195f-06e9-43f9-9ce9-6028927bdada

	measure 'Tempo Medio nello Stato' = ```
			
			VAR StatusTradotto = 
			    SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            IF(
			                ISBLANK(StatusTradotto),
			                TRUE(),
			                'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			            )
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi MBI 2'[Status], "Open")
			
			VAR TransizioniEntrata =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('MBI Transition Status'),
			                'MBI Transition Status'[to_status] IN StatiDellaFase
			                && NOT('MBI Transition Status'[from_status] IN StatiDellaFase)
			                && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			            ),
			            "ie_issue_key", 'MBI Transition Status'[issue_key],
			            "ie_data", 'MBI Transition Status'[transition_date]
			        )
			    )
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('MBI Transition Status'),
			                'MBI Transition Status'[from_status] IN StatiDellaFase
			                && NOT('MBI Transition Status'[to_status] IN StatiDellaFase)
			                && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'MBI Transition Status'[issue_key],
			            "iu_data", 'MBI Transition Status'[transition_date]
			        )
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE(
			        VALUES('MBI Transition Status'[issue_key]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[to_status] IN StatiDellaFase
			            || 'MBI Transition Status'[from_status] IN StatiDellaFase
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS(
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'MBI Transition Status'[issue_key]
			        VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = issueKey)
			        VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = issueKey)
			        VAR sommaSoggiorni =
			            SUMX(
			                FILTER(
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN COUNTROWS(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                    ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata),
			                        [iu_data]
			                    )
			                RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			            )
			        RETURN 
			            IF(
			                ISBLANK(sommaSoggiorni) && IsOpen,
			                0,
			                IF(NOT ISBLANK(sommaSoggiorni), sommaSoggiorni, BLANK())
			            )
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(tabellaGiorni, NOT ISBLANK([giorni_totali])),
			    [giorni_totali]
			)
			```
		displayFolder: Grafico 2
		lineageTag: a305cff8-3e39-4a99-8172-98ffcc9e53a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conteggio Rework per Stato' = ```
			
			VAR StatoCorrente = MAX('Workflow Fasi MBI 2'[Status Tradotto])
			VAR OrdineCorrente = 
			    MAXX(
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatoCorrente
			        ),
			        'Workflow Fasi MBI 2'[OrdineFase]
			    )
			
			RETURN
			COUNTROWS(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('MBI Transition Status'),
			                VAR CurrentFromStatus = 'MBI Transition Status'[from_status]
			                VAR CurrentToStatus = 'MBI Transition Status'[to_status]
			                VAR CurrentKey = 'MBI Transition Status'[issue_key]
			                VAR CurrentDate = 'MBI Transition Status'[transition_date]
			
			                VAR OrdineFrom =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi MBI 2'),
			                            'Workflow Fasi MBI 2'[Status] = CurrentFromStatus),
			                        'Workflow Fasi MBI 2'[OrdineFase]
			                    )
			                VAR OrdineTo =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi MBI 2'),
			                            'Workflow Fasi MBI 2'[Status] = CurrentToStatus),
			                        'Workflow Fasi MBI 2'[OrdineFase]
			                    )
			
			                VAR DataUscita =
			                    CALCULATE(
			                        MIN('MBI Transition Status'[transition_date]),
			                        FILTER(
			                            ALL('MBI Transition Status'),
			                            'MBI Transition Status'[issue_key] = CurrentKey
			                            && 'MBI Transition Status'[transition_date] > CurrentDate
			                            && 'MBI Transition Status'[to_status] = CurrentFromStatus
			                            && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			                        )
			                    )
			
			                RETURN
			                    NOT ISBLANK(OrdineFrom)
			                    && NOT ISBLANK(OrdineTo)
			                    && OrdineTo < OrdineFrom
			                    && OrdineFrom = OrdineCorrente
			                    && NOT ISBLANK(DataUscita)
			            ),
			            "issue_key", 'MBI Transition Status'[issue_key]
			        )
			    )
			)
			```
		formatString: 0
		displayFolder: Grafico 3
		lineageTag: 7eb6fa48-5d21-45a9-8109-65cc933670a0

	measure 'Data Ingresso Stato' =
			
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Macro Business Initiative'[Issue Created Date]),
			        REMOVEFILTERS('Jira Macro Business Initiative'),
			        'Jira Macro Business Initiative'[Issue key] = issueKey
			    )
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[issue_key] = issueKey
			                && 'MBI Transition Status'[to_status] IN StatiDellaFase
			                && NOT('MBI Transition Status'[from_status] IN StatiDellaFase)
			                && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			        )
			    )
			
			RETURN
			IF(
			    StatusTradotto = "Conferma Perimetro",
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Grafico 2
		lineageTag: 3beb9135-8dd7-4289-9612-99e684bae946

	measure 'Data Uscita Stato' =
			
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			VAR StatiDellaFase =
