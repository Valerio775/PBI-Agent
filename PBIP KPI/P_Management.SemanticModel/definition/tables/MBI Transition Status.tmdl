	measure 'Filtro Rework' = ```
			
			VAR FaseSelezionata = 
			    CALCULATE(
			        SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto]),
			        ALLSELECTED('Workflow Fasi MBI 2')
			    )
			
			VAR OrdineSelezionato =
			    IF(
			        NOT ISBLANK(FaseSelezionata),
			        MAXX(
			            FILTER(ALL('Workflow Fasi MBI 2'),
			                'Workflow Fasi MBI 2'[Status Tradotto] = FaseSelezionata),
			            'Workflow Fasi MBI 2'[OrdineFase]
			        ),
			        BLANK()
			    )
			
			VAR OrdineFromRiga = MAX('MBI Transition Status'[OrdineFrom])
			VAR OrdineToRiga = MAX('MBI Transition Status'[OrdineTo])
			
			RETURN
			IF(
			    NOT ISBLANK(OrdineFromRiga)
			    && NOT ISBLANK(OrdineToRiga)
			    && OrdineToRiga < OrdineFromRiga
			    && (ISBLANK(OrdineSelezionato) || OrdineFromRiga = OrdineSelezionato),
			    1, 0
			)
			```
