	measure 'Filtro_Tabella_Dinamica MBI' = ```
			
			VAR _End = [ToStatus_MBI]
			
			-- Recuperiamo l'intervallo del mese selezionato nel report
			VAR _MinDate = MIN('MBI Transition Status'[transition_date]) 
			VAR _MaxDate = MAX('MBI Transition Status'[transition_date])
			
			RETURN
			IF( 
			    -- 1. Esiste la data di fine?
			    NOT ISBLANK(_End) 
			    
			    -- 2. La data di fine (Approved) è nel mese selezionato?
			    && _End >= _MinDate 
			    && _End <= _MaxDate, 
			    1, 
			    0 
			)
