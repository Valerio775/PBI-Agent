	measure 'Conteggio Pass-Through Semplificato 2' = ```
			
			VAR IsSingleIssueSelected =
			    ISFILTERED('Jira Macro Business Initiative'[Issue key])
			    &&
			    CALCULATE(
			        DISTINCTCOUNT('Jira Macro Business Initiative'[Issue key]),
			        ALLSELECTED('Jira Macro Business Initiative')
			    ) = 1
			VAR Risultato =
			    CALCULATE(
			        DISTINCTCOUNT('MBI Transition Status'[issue_key]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[From OrdineBarra Semplificato]
			                = SELECTEDVALUE('Workflow Fasi MBI Semplificate'[OrdineBarra])
			            &&
			            'MBI Transition Status'[To OrdineBarra Semplificato]
			                <> SELECTEDVALUE('Workflow Fasi MBI Semplificate'[OrdineBarra])
			        )
			    )
			RETURN
			    IF(
			        IsSingleIssueSelected && Risultato > 1,
			        BLANK(),
			        Risultato
			    )
			
			    /*
			    Conteggio Pass-Through Semplificato 2 = 
			VAR IsSingleIssueSelected =
			    ISFILTERED('Jira Macro Business Initiative'[Issue key])
			    &&
			    CALCULATE(
			        DISTINCTCOUNT('Jira Macro Business Initiative'[Issue key]),
			        ALLSELECTED('Jira Macro Business Initiative')
			    ) = 1
			
			VAR OrdineFaseAsse =
			    SELECTEDVALUE('Workflow Fasi MBI Semplificate'[OrdineBarra])
			
			VAR StatoCorrenteIssue =
			    SELECTEDVALUE('Jira Macro Business Initiative'[Issue status])
			
			VAR OrdineFaseCorrenteIssue =
			    LOOKUPVALUE(
			        'Workflow Fasi MBI Semplificate'[OrdineBarra],
			        'Workflow Fasi MBI Semplificate'[Status],
			        StatoCorrenteIssue
			    )
			
			VAR Risultato =
			    CALCULATE(
			        DISTINCTCOUNT('MBI Transition Status'[issue_key]),
			        FILTER(
			            ALL('MBI Transition Status'),
			            'MBI Transition Status'[From OrdineBarra Semplificato]
			                = SELECTEDVALUE('Workflow Fasi MBI Semplificate'[OrdineBarra])
			            &&
			            'MBI Transition Status'[To OrdineBarra Semplificato]
			                <> SELECTEDVALUE('Workflow Fasi MBI Semplificate'[OrdineBarra])
			        )
			    )
			
			RETURN
			    IF(
			        IsSingleIssueSelected
			            && (
			                OrdineFaseAsse > OrdineFaseCorrenteIssue   -- fase successiva a quella attuale
			                || Risultato > 1
			            ),
			        BLANK(),
			        Risultato
			    )
			    */
			```
		formatString: 0
		displayFolder: Executive Journey
		lineageTag: a5ed113b-fda2-48f2-ab59-5f0b2d5b202b

	measure 'MBI Tempo Storico Medio Fisso' =
			
			VAR FaseCorrente =
			    SELECTEDVALUE(
			        'Workflow Fasi MBI Semplificate'[OrdineFase]
			    )
			RETURN
			CALCULATE(
			    [MBI Tempo Storico Medio nello Stato Semplificato],
			    REMOVEFILTERS('Jira Macro Business Initiative'),
			    REMOVEFILTERS('MBI Transition Status'),
			    TREATAS(
			        { FaseCorrente },
			        'Workflow Fasi MBI Semplificate'[OrdineFase]
			    )
			)
		displayFolder: Executive Journey
		lineageTag: a6f108b2-30d7-441b-9019-b01f56fd04f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Giorni Issue in Stato (verifica)' =
			
			VAR IssueCorrente =
			    SELECTEDVALUE ( 'MBI Transition Status'[issue_key] )
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi MBI Semplificate'[OrdineFase] )
			
			RETURN
			CALCULATE (
			    VAR TransizioniEntrata =
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'MBI Transition Status' ),
			                'MBI Transition Status'[To OrdineFase Semplificate] = OrdineFaseCorrente
			                    && 'MBI Transition Status'[From OrdineFase Semplificate] <> OrdineFaseCorrente
			                    && 'MBI Transition Status'[issue_key] = IssueCorrente
			            ),
			            "ie_data", 'MBI Transition Status'[transition_date]
			        )
			    VAR TransizioniUscita =
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'MBI Transition Status' ),
			                'MBI Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			                    && 'MBI Transition Status'[To OrdineFase Semplificate] <> OrdineFaseCorrente
			                    && 'MBI Transition Status'[issue_key] = IssueCorrente
			            ),
			            "iu_data", 'MBI Transition Status'[transition_date]
			        )
			    RETURN
			    SUMX (
			        TransizioniEntrata,
			        VAR dataEntrata = [ie_data]
			        VAR primaUscita = MINX ( FILTER ( TransizioniUscita, [iu_data] > dataEntrata ), [iu_data] )
			        RETURN IF ( NOT ISBLANK ( primaUscita ), DATEDIFF ( dataEntrata, primaUscita, DAY ) )
			    )
			)
		formatString: 0
		lineageTag: 8f7a87fc-fd21-44b4-b357-aa02c779f457

	measure 'IE Passata da Stato (flag)' =
			
			VAR IssueCorrente =
			    SELECTEDVALUE ( 'MBI Transition Status'[issue_key] )
			
			VAR OrdineBarraCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi MBI Semplificate'[OrdineBarra] )
			
			RETURN
			CALCULATE (
			    COUNTROWS (
			        FILTER (
			            ALL ( 'MBI Transition Status' ),
			            'MBI Transition Status'[From OrdineBarra Semplificato] = OrdineBarraCorrente
			                && 'MBI Transition Status'[To OrdineBarra Semplificato] <> OrdineBarraCorrente
			                && 'MBI Transition Status'[issue_key] = IssueCorrente
			        )
			    )
			)
		formatString: 0
		lineageTag: a201db78-a40e-4665-a929-5ec4bf8db158

	measure 'MBI Tempo Storico Medio nello Stato Semplificato Leam Time' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi MBI Semplificate'[OrdineFase]
			    )
			
			VAR TransizioniEntrata =
			    SELECTCOLUMNS (
			        FILTER (
			            ALL ( 'MBI Transition Status' ),
			            'MBI Transition Status'[To OrdineFase Semplificate] = OrdineFaseCorrente
			                &&
			            'MBI Transition Status'[From OrdineFase Semplificate] <> OrdineFaseCorrente
			        ),
			        "ie_issue_key", 'MBI Transition Status'[issue_key],
			        "ie_data", 'MBI Transition Status'[transition_date]
			    )
			
			VAR TransizioniUscita =
			    SELECTCOLUMNS (
			        FILTER (
			            'MBI Transition Status',
			            'MBI Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			                &&
			            'MBI Transition Status'[To OrdineFase Semplificate] <> OrdineFaseCorrente
			        ),
			        "iu_issue_key", 'MBI Transition Status'[issue_key],
			        "iu_data", 'MBI Transition Status'[transition_date]
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE (
			        VALUES ( 'MBI Transition Status'[issue_key] ),
			        FILTER (
			            ALL ( 'MBI Transition Status' ),
			            'MBI Transition Status'[To OrdineFase Semplificate] = OrdineFaseCorrente
			                ||
			            'MBI Transition Status'[From OrdineFase Semplificate] = OrdineFaseCorrente
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS (
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'MBI Transition Status'[issue_key]
			        VAR entrateIssue =
			            FILTER ( TransizioniEntrata, [ie_issue_key] = issueKey )
			        VAR usciteIssue =
			            FILTER ( TransizioniUscita, [iu_issue_key] = issueKey )
			
			        RETURN
			            SUMX (
			                FILTER (
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN
			                        COUNTROWS (
			                            FILTER (
			                                usciteIssue,
			                                [iu_data] > dataEntrata
			                            )
			                        ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX (
			                        FILTER (
			                            usciteIssue,
			                            [iu_data] > dataEntrata
			                        ),
			                        [iu_data]
			                    )
			                RETURN
			                    DATEDIFF (
			                        dataEntrata,
			                        primaUscita,
			                        DAY
			                    )
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        tabellaGiorni,
			        NOT ISBLANK ( [giorni_totali] )
			    ),
			    [giorni_totali]
			)
		displayFolder: Executive Journey
		lineageTag: 3a5ad22a-b216-43c0-8059-9c2de95319d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MBI Giorni Issue Selezionata per Stato TEST' =
			
			VAR OrdineBarraCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi MBI Semplificate'[OrdineBarra] )
			
			VAR IssueSelezionata =
			    SELECTEDVALUE ( 'Jira Macro Business Initiative'[Issue key] )
			
			RETURN
			IF (
			    NOT ISBLANK ( IssueSelezionata ),
			
			    CALCULATE (
			        VAR TransizioniEntrataDaTransizioni =
			            SELECTCOLUMNS (
			                FILTER (
			                    ALL ( 'MBI Transition Status' ),
			                    'MBI Transition Status'[To OrdineBarra Semplificato] = OrdineBarraCorrente
			                        && 'MBI Transition Status'[From OrdineBarra Semplificato] <> OrdineBarraCorrente
			                        && 'MBI Transition Status'[issue_key] = IssueSelezionata
			                ),
			                "ie_data", 'MBI Transition Status'[transition_date]
			            )
			
			        -- Se lo stato è "Open" e l'issue non ha una transizione di entrata registrata,
			        -- usa la data di creazione come data di ingresso
			        VAR EntrataDaCreazione =
			            SELECTCOLUMNS (
			                FILTER (
			                    ALL ( 'Jira Macro Business Initiative' ),
			                    OrdineBarraCorrente = 1
			                        && 'Jira Macro Business Initiative'[Issue key] = IssueSelezionata
			                        && COUNTROWS ( TransizioniEntrataDaTransizioni ) = 0
			                ),
			                "ie_data", 'Jira Macro Business Initiative'[Issue created date]
			            )
			
			        VAR TransizioniEntrata =
			            UNION ( TransizioniEntrataDaTransizioni, EntrataDaCreazione )
			
			        VAR TransizioniUscita =
			            SELECTCOLUMNS (
			                FILTER (
			                    ALL ( 'MBI Transition Status' ),
			                    'MBI Transition Status'[From OrdineBarra Semplificato] = OrdineBarraCorrente
			                        && 'MBI Transition Status'[To OrdineBarra Semplificato] <> OrdineBarraCorrente
			                        && 'MBI Transition Status'[issue_key] = IssueSelezionata
			                ),
			                "iu_data", 'MBI Transition Status'[transition_date]
			            )
			
			        RETURN
			        SUMX (
			            TransizioniEntrata,
			            VAR dataEntrata = [ie_data]
			            VAR primaUscita =
			                MINX (
			                    FILTER ( TransizioniUscita, [iu_data] > dataEntrata ),
			                    [iu_data]
			                )
			            RETURN
			                IF (
			                    NOT ISBLANK ( primaUscita ),
			                    DATEDIFF ( dataEntrata, primaUscita, DAY ),
			                    DATEDIFF ( dataEntrata, TODAY (), DAY )
			                )
			        ),
			        ALL ()
			    ),
			
			    [MBI Aging Medio Corrente nello Stato Semplificato]
			)
		formatString: 0
		lineageTag: 4b27d2cb-b4c2-4648-b15e-e166652a61b3

	measure 'MBI Aging Medio Corrente nello Stato Executive' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi MBI Semplificate'[OrdineFase]
			    )
			
			VAR StatiDellaFase =
			    CALCULATETABLE (
			        VALUES ( 'Workflow Fasi MBI Semplificate'[Status] ),
			        FILTER (
			            ALL ( 'Workflow Fasi MBI Semplificate' ),
			            'Workflow Fasi MBI Semplificate'[OrdineFase]
			                = OrdineFaseCorrente
			        )
			    )
			
			VAR IssueAttualmenteInFase =
			    CALCULATETABLE (
			        VALUES ( 'Jira Macro Business Initiative'[Issue key] ),
			        TREATAS (
			            StatiDellaFase,
			            'Jira Macro Business Initiative'[Issue status]
			        )
			    )
			
			VAR TabellaAging =
			    ADDCOLUMNS (
			        IssueAttualmenteInFase,
			
			        "DataEntrataFase",
			
			        VAR CurrentIssue =
			            'Jira Macro Business Initiative'[Issue key]
			
			        VAR UltimaEntrata =
			            CALCULATE (
			                MAX ( 'MBI Transition Status'[transition_date] ),
			
			                FILTER (
			                    ALL ( 'MBI Transition Status' ),
			                    'MBI Transition Status'[issue_key] = CurrentIssue
			                        &&
			                    'MBI Transition Status'[To OrdineFase Semplificate]
			                        = OrdineFaseCorrente
			                        &&
			                    'MBI Transition Status'[From OrdineFase Semplificate]
			                        <> OrdineFaseCorrente
			                )
			            )
			
			        VAR CreatedDate =
			            CALCULATE (
			                MAX ( 'Jira Macro Business Initiative'[created_date] )
			            )
			
			        RETURN
			            IF (
			                OrdineFaseCorrente = 1,
			                COALESCE ( UltimaEntrata, CreatedDate ),
			                UltimaEntrata
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        TabellaAging,
			        NOT ISBLANK ( [DataEntrataFase] )
			    ),
			    DATEDIFF (
			        [DataEntrataFase],
			        TODAY (),
			        DAY
			    )
			)
		displayFolder: Executive Journey
		lineageTag: 096ef9fe-b0ea-47e9-af25-e9307d9422f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

