	column 'Lead Time - OpenApproved' = ```
			
			// cerca la data più vecchia dell'issue nello stato from_status
			VAR _startDate = 
			    CALCULATE (
			         MIN ( 'MBI Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'MBI Transition Status', 'MBI Transition Status'[issue_key] ),
			        'MBI Transition Status'[from_status] = "Open"
			    )
			
			-- cerco l'ultima volta che la issue è arrivata nello stato to_status
			VAR _lastDate = 
			    CALCULATE (
			        MAX ( 'MBI Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'MBI Transition Status', 'MBI Transition Status'[issue_key] ),
			        'MBI Transition Status'[to_status] = "Approved",
			        'MBI Transition Status'[from_status] <> "Approved" // evita duplicati se lo stato di partenza e arrivo coincidono
			    )
			
			// conta i giorni che intercorrono da from_status a to_status (conta anche i giorni degli stati intermedi)
			RETURN 
			IF ( 
			    'MBI Transition Status'[to_status] = "Approved" 
			    && 'MBI Transition Status'[transition_date] = _lastDate
			    && NOT ISBLANK ( _startDate ),
			    'MBI Transition Status'[transition_date] - _startDate,
			    BLANK()
			)
			```
		dataType: double
		formatString: 0
		lineageTag: 54d8ed8c-0876-405d-83cb-8069e3782a1d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MeseAnno_ = ```
			
			VAR y = CONVERT(YEAR ( 'MBI Transition Status'[transition_date] ), STRING)
			VAR m = MONTH ( 'MBI Transition Status'[transition_date]  )
			VAR mShort =
			    SWITCH (
			        m,
			        1, "01", 2, "02", 3, "03", 4, "04", 5, "05", 6, "06",
			        7, "07", 8, "08", 9, "09", 10, "10", 11, "11", 12, "12"
			    )
			RETURN y & "-" &  mShort 
			
			
			```
		lineageTag: 3d5623f3-4560-484f-b14e-760e703660ee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

