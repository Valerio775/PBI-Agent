	column 'Giorni Rework' =
			
			VAR DataUscita = [Data Uscita Rework]
			VAR DataIngresso = 'MBI Transition Status'[transition_date]
			RETURN
			IF(
			    ISBLANK(DataUscita),
			    BLANK(),
			    DATEDIFF(DataIngresso, DataUscita, DAY)
			)
