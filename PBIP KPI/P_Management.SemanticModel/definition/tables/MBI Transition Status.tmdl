	measure 'COUNT Backlog Semplificato Actual' =
			
			VAR StatusAsse =
			    SELECTEDVALUE ( 'Workflow Fasi MBI Semplificate'[Status] )
			
			VAR IssueKeySelezionata =
			    SELECTEDVALUE ( 'Jira Macro Business Initiative'[Issue key] )
			
			VAR StatusIssueSelezionata =
			    SELECTEDVALUE ( 'Jira Macro Business Initiative'[Issue status] )
			
			VAR Risultato =
			    IF (
			        NOT ISBLANK ( IssueKeySelezionata ),
			        // Issue selezionata -> mostra 1 solo sulla barra del suo stato attuale
			        IF ( StatusAsse = StatusIssueSelezionata, 1 ),
			        // Nessuna selezione -> vista aggregata
			        CALCULATE (
			            DISTINCTCOUNT ( 'Jira Macro Business Initiative'[Issue key] ),
			            REMOVEFILTERS ( 'Jira Macro Business Initiative' ),
			            TREATAS (
			                VALUES ( 'Workflow Fasi MBI Semplificate'[Status] ),
			                'Jira Macro Business Initiative'[Issue status]
			            )
			        )
			    )
			
			RETURN
			IF (
			    NOT ISBLANK ( IssueKeySelezionata ),
			    MIN ( Risultato, 1 ),
			    Risultato
			)
		formatString: 0
		displayFolder: Executive Journey
		lineageTag: ebeb60ed-edbf-4f59-923b-06ef8a6a535f

