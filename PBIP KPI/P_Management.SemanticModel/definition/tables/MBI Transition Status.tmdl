	measure 'Data Uscita Rework' =
			
			VAR CurrentKey = MAX('MBI Transition Status'[issue_key])
			VAR CurrentDate = MAX('MBI Transition Status'[transition_date])
			VAR CurrentFromStatus = MAX('MBI Transition Status'[from_status])
			
			RETURN
			CALCULATE(
			    MIN('MBI Transition Status'[transition_date]),
			    FILTER(
			        ALL('MBI Transition Status'),
			        'MBI Transition Status'[issue_key] = CurrentKey
			        && 'MBI Transition Status'[transition_date] > CurrentDate
			        && 'MBI Transition Status'[to_status] = CurrentFromStatus
			        && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			    )
			)
		formatString: General Date
		displayFolder: Grafico 3
		lineageTag: 31accb82-fd82-4e75-b680-c68952092474

	measure 'Media Giorni Rework' = ```
			
			VAR OrdineSelezionato = 
			    MAX('Workflow Fasi MBI 2'[OrdineFase])
			
			VAR TabellaFiltrata =
			    FILTER(
			        ALL('MBI Transition Status'),
			        'MBI Transition Status'[IsRework] = 1
			        && 'MBI Transition Status'[OrdineFrom] = OrdineSelezionato
			    )
			
			RETURN
			IF(
			    ISBLANK(OrdineSelezionato),
			    BLANK(),
			    AVERAGEX(
			        TabellaFiltrata,
			        VAR DataIngresso = 'MBI Transition Status'[transition_date]
			        VAR DataUscita = 
			            CALCULATE(
			                MIN('MBI Transition Status'[transition_date]),
			                REMOVEFILTERS('Workflow Fasi MBI 2'),
			                FILTER(
			                    ALL('MBI Transition Status'),
			                    'MBI Transition Status'[issue_key] = EARLIER('MBI Transition Status'[issue_key])
			                    && 'MBI Transition Status'[transition_date] > EARLIER('MBI Transition Status'[transition_date])
			                    && 'MBI Transition Status'[to_status] = EARLIER('MBI Transition Status'[from_status])
			                    && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			                )
			            )
			        RETURN
			        -- MODIFICA QUI: Se non c'è una data di uscita, restituiamo BLANK(). 
			        -- AVERAGEX ignora automaticamente le righe che restituiscono BLANK()
			        IF(
			            ISBLANK(DataUscita),
			            BLANK(), 
			            DATEDIFF(DataIngresso, DataUscita, DAY)
			        )
			    )
			)
			```
		displayFolder: Grafico 3
		lineageTag: 1d1fd9d0-e7da-4164-8b4c-0a577db0fbd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Somma dei tempi nello stato' = ```
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi MBI 2'[Status], "Open")
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Macro Business Initiative'[Issue Created Date Formatted]),
			        REMOVEFILTERS('Jira Macro Business Initiative'),
			        'Jira Macro Business Initiative'[Issue key] = issueKey
			    )
			
			VAR entrateIssue =
			    FILTER(
			        ALL('MBI Transition Status'),
			        'MBI Transition Status'[issue_key] = issueKey
			        && 'MBI Transition Status'[to_status] IN StatiDellaFase
			        && NOT('MBI Transition Status'[from_status] IN StatiDellaFase)
			        && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			    )
			
			VAR usciteIssue =
			    FILTER(
			        ALL('MBI Transition Status'),
			        'MBI Transition Status'[issue_key] = issueKey
			        && 'MBI Transition Status'[from_status] IN StatiDellaFase
			        && NOT('MBI Transition Status'[to_status] IN StatiDellaFase)
			        && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			    )
			
			VAR primaUscitaOpen =
			    MINX(usciteIssue, 'MBI Transition Status'[transition_date])
			
			VAR giorniOpen =
			    VAR primaEntrata = 
			        IF(
			            NOT ISBLANK(DataCreazioneOpen) && DataCreazioneOpen <= primaUscitaOpen,
			            DataCreazioneOpen,
			            primaUscitaOpen
			        )
			    VAR primaSoggiorno =
			        IF(
			            NOT ISBLANK(primaEntrata) && NOT ISBLANK(primaUscitaOpen) && primaEntrata < primaUscitaOpen,
			            DATEDIFF(primaEntrata, primaUscitaOpen, DAY),
			            0
			        )
			    VAR soggiorniSuccessivi =
			        SUMX(
			            FILTER(
			                entrateIssue,
			                VAR dataEntrata = 'MBI Transition Status'[transition_date]
			                RETURN COUNTROWS(
			                    FILTER(usciteIssue, 'MBI Transition Status'[transition_date] > dataEntrata)
			                ) > 0
			            ),
			            VAR dataEntrata = 'MBI Transition Status'[transition_date]
			            VAR primaUscitaSucc =
			                MINX(
			                    FILTER(usciteIssue, 'MBI Transition Status'[transition_date] > dataEntrata),
			                    'MBI Transition Status'[transition_date]
			                )
			            RETURN DATEDIFF(dataEntrata, primaUscitaSucc, DAY)
			        )
			    RETURN primaSoggiorno + soggiorniSuccessivi
			
			VAR giorniAltriStati =
			    SUMX(
			        FILTER(
			            entrateIssue,
			            VAR dataEntrata = 'MBI Transition Status'[transition_date]
			            RETURN COUNTROWS(
			                FILTER(usciteIssue, 'MBI Transition Status'[transition_date] > dataEntrata)
			            ) > 0
			        ),
			        VAR dataEntrata = 'MBI Transition Status'[transition_date]
			        VAR primaUscita =
			            MINX(
			                FILTER(usciteIssue, 'MBI Transition Status'[transition_date] > dataEntrata),
			                'MBI Transition Status'[transition_date]
			            )
			        RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			    )
			
			RETURN
			IF(IsOpen, giorniOpen, giorniAltriStati)
			```
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 56496a61-0776-4d6c-b1fb-1f7a5ebb4dd3

	measure 'Debug Entrate Issue' =
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi MBI 2'[Status Tradotto])
			VAR issueKey = SELECTEDVALUE('MBI Transition Status'[issue_key])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi MBI 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi MBI 2'),
			            'Workflow Fasi MBI 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR entrateIssue =
			    FILTER(
			        ALL('MBI Transition Status'),
			        'MBI Transition Status'[issue_key] = issueKey
			        && 'MBI Transition Status'[to_status] IN StatiDellaFase
			        && NOT('MBI Transition Status'[from_status] IN StatiDellaFase)
			        && 'MBI Transition Status'[from_status] <> 'MBI Transition Status'[to_status]
			    )
			
			RETURN
			COUNTROWS(entrateIssue)
