	measure 'Media Filtrata GoLive' = ```
			
			VAR SelectedMin = MIN('Date Table'[Date])
			VAR SelectedMax = MAX('Date Table'[Date])
			VAR AbsoluteMin = CALCULATE(MIN('Date Table'[Date]), ALL('Date Table'))
			VAR AbsoluteMax = CALCULATE(MAX('Date Table'[Date]), ALL('Date Table'))
			VAR IsSlicerActive = (SelectedMin <> AbsoluteMin) || (SelectedMax <> AbsoluteMax)
			VAR FilteredIssues = 
			    CALCULATETABLE(
			        VALUES('Jira Business Feature 2'[Issue Macro Business Initiative])
			    )
			RETURN
			IF(
			    NOT IsSlicerActive,
			    AVERAGEX(
			        VALUES('MBI Transition Status'[issue_key]),
			        CALCULATE(MIN('MBI Transition Status'[Giorni_In_Stato_Colonna]))
			    ),
			    CALCULATE(
			        AVERAGEX(
			            VALUES('MBI Transition Status'[issue_key]),
			            CALCULATE(MIN('MBI Transition Status'[Giorni_In_Stato_Colonna]))
			        ),
			        TREATAS(FilteredIssues, 'Jira Macro Business Initiative'[Issue key])
			    )
			)
			```
