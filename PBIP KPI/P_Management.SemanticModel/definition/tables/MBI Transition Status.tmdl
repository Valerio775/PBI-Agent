	measure 'MBI Tempo Storico Medio nello Stato Semplificato' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi MBI Semplificate'[OrdineBarra] )
			
			RETURN
			CALCULATE (
			    VAR TransizioniEntrata =
			        SELECTCOLUMNS (
			            FILTER (
			                'MBI Transition Status',
			                'MBI Transition Status'[To OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'MBI Transition Status'[From OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "ie_issue_key", 'MBI Transition Status'[issue_key],
			            "ie_data", 'MBI Transition Status'[transition_date]
			        )
			
			    VAR TransizioniUscita =
			        SELECTCOLUMNS (
			            FILTER (
			                'MBI Transition Status',
			                'MBI Transition Status'[From OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'MBI Transition Status'[To OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "iu_issue_key", 'MBI Transition Status'[issue_key],
			            "iu_data", 'MBI Transition Status'[transition_date]
			        )
			
			    -- Una riga per OGNI singolo soggiorno (entrata->prima uscita), non aggregato per issue
			    VAR TabellaSoggiorni =
			        ADDCOLUMNS (
			            TransizioniEntrata,
			            "giorni_soggiorno",
			            VAR issueKey = [ie_issue_key]
			            VAR dataEntrata = [ie_data]
			            VAR usciteSuccessive =
			                FILTER (
			                    TransizioniUscita,
			                    [iu_issue_key] = issueKey && [iu_data] > dataEntrata
			                )
			            VAR primaUscita = MINX ( usciteSuccessive, [iu_data] )
			            RETURN
			                IF ( NOT ISBLANK ( primaUscita ), DATEDIFF ( dataEntrata, primaUscita, DAY ) )
			        )
			
			    RETURN
			    AVERAGEX (
			        FILTER ( TabellaSoggiorni, NOT ISBLANK ( [giorni_soggiorno] ) ),
			        [giorni_soggiorno]
			    ),
			    REMOVEFILTERS ( 'MBI Transition Status' ),
			    REMOVEFILTERS ( 'Workflow Fasi MBI' ),
			    REMOVEFILTERS ( 'Jira Macro Business Initiative' ),
			    REMOVEFILTERS ( 'Workflow Fasi MBI Semplificate 2' )
			)
		displayFolder: Executive Journey
		lineageTag: ca90338a-f36d-43ef-8a20-434e90e4fbe0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MBI Aging Medio Corrente nello Stato Semplificato' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi MBI Semplificate'[OrdineBarra]
			    )
			
			VAR StatiDellaFase =
			    CALCULATETABLE (
			        VALUES ( 'Workflow Fasi MBI Semplificate'[Status] ),
			        FILTER (
			            ALL ( 'Workflow Fasi MBI Semplificate' ),
			            'Workflow Fasi MBI Semplificate'[OrdineBarra]
			                = OrdineFaseCorrente
			        )
			    )
			
			VAR IssueAttualmenteInFase =
			    CALCULATETABLE (
			        VALUES ( 'Jira Macro Business Initiative'[Issue key] ),
			        TREATAS (
			            StatiDellaFase,
			            'Jira Macro Business Initiative'[Issue status]
			        )
			    )
			
			VAR TabellaAging =
			    ADDCOLUMNS (
			        IssueAttualmenteInFase,
			
			        "DataEntrataFase",
			
			        VAR CurrentIssue =
			            'Jira Macro Business Initiative'[Issue key]
			
			        VAR UltimaEntrata =
			            CALCULATE (
			                MAX ( 'MBI Transition Status'[transition_date] ),
			
			                FILTER (
			                    ALL ( 'MBI Transition Status' ),
			                    'MBI Transition Status'[issue_key] = CurrentIssue
			                        &&
			                    'MBI Transition Status'[To OrdineBarra Semplificato]
			                        = OrdineFaseCorrente
			                        &&
			                    'MBI Transition Status'[From OrdineBarra Semplificato]
			                        <> OrdineFaseCorrente
			                )
			            )
			
			        VAR CreatedDate =
			            CALCULATE (
			                MAX ( 'Jira Macro Business Initiative'[created_date] )
			            )
			
			        RETURN
			            IF (
			                OrdineFaseCorrente = 1,
			                COALESCE ( UltimaEntrata, CreatedDate ),
			                UltimaEntrata
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        TabellaAging,
			        NOT ISBLANK ( [DataEntrataFase] )
			    ),
			    DATEDIFF (
			        [DataEntrataFase],
			        TODAY (),
			        DAY
			    )
			)
		displayFolder: Executive Journey
		lineageTag: 2085a409-6c90-451b-a4b6-2b39fea9f751

