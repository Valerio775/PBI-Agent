	column Giorni_In_Stato_Colonna =
			
			VAR currentIssue = 'MBI Transition Status'[issue_key]
			VAR currentStatus = 'MBI Transition Status'[to_status]
			
			VAR startDate =
			    CALCULATE(
			        MIN('MBI Transition Status'[transition_date]),
			        ALLEXCEPT('MBI Transition Status', 'MBI Transition Status'[issue_key], 'MBI Transition Status'[to_status])
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDate),
			    DATEDIFF(startDate, TODAY(), DAY)
			)
		formatString: 0
		displayFolder: Grafico 1
		lineageTag: eeb3b5cb-bd25-47b0-8f1a-348706c3f17b
		summarizeBy: sum

