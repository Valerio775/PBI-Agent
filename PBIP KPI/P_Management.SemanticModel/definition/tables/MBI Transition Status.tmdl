	column 'Lead Time - Open-HighlevelFunctional' = ```
			
			// cerca la data più vecchia dell'issue nello stato from_status
			VAR _startDate = 
			    CALCULATE (
			        MIN ( 'MBI Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'MBI Transition Status', 'MBI Transition Status'[issue_key] ),
			        'MBI Transition Status'[from_status] = "Open"
			    )
			
			-- cerco l'ultima volta che la issue è arrivata nello stato to_status
			VAR _lastDate = 
			    CALCULATE (
			        MAX ( 'MBI Transition Status'[transition_date] ),
			        ALLEXCEPT ( 'MBI Transition Status', 'MBI Transition Status'[issue_key] ),
			        'MBI Transition Status'[to_status] = "High-Level Functional Requirement",
			        'MBI Transition Status'[from_status] <> "High-Level Functional Requirement" // evita duplicati se lo stato di partenza e arrivo coincidono
			    )
			
			// conta i giorni che intercorrono da from_status a to_status (conta anche i giorni degli stati intermedi)
			RETURN 
			IF ( 
			    'MBI Transition Status'[to_status] = "High-Level Functional Requirement" 
			    && 'MBI Transition Status'[transition_date] = _lastDate
			    && NOT ISBLANK ( _startDate ),
			    'MBI Transition Status'[transition_date] - _startDate,
			    BLANK()
			)
			```
		dataType: double
		lineageTag: c24f4e04-64f1-4061-8e13-af2d54567dcf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

