	column 'Comala Stato Documento' = ```
			
			VAR _activity = 'Confluence Comala Activity'[activity]
			VAR _desc = 'Confluence Comala Activity'[description]
			VAR _startMarker = "changed state to "
			VAR _startPos = SEARCH(_startMarker, _desc, 1, BLANK())
			VAR _startText = _startPos + LEN(_startMarker)
			VAR _endPos = 
			    IF(
			        ISERROR(_startPos),
			        BLANK(),
			        SEARCH(" at ", _desc, _startText, BLANK())
			    )
			RETURN
			    IF(
			        _activity <> "state" 
			            || ISERROR(_startPos) 
			            || ISERROR(_endPos) 
			            || ISBLANK(_endPos) 
			            || _endPos <= _startText,
			        BLANK(),
			        MID(_desc, _startText, _endPos - _startText)
			    )
			```
		lineageTag: c0857d66-ed57-491e-8062-8d28e5d46d6a
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Date Convertita' =
			
			VAR _testo = 'Confluence Comala Activity'[date]
			VAR _senzaOffset = LEFT(_testo, 19) -- toglie " +02:00" tenendo solo "2026-07-02 12:21:09"
			RETURN
			    DATEVALUE(LEFT(_senzaOffset, 10)) + TIMEVALUE(MID(_senzaOffset, 12, 8))
		formatString: General Date
		lineageTag: d53e00d3-ca23-459e-a1a2-b251540b5838
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

