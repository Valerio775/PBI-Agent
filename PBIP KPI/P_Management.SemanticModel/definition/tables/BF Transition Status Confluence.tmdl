	measure 'Data Ingresso Rework BF Journey' =
			
			VAR CurrentKey = MIN('BF Transition Status Confluence'[issue_key])
			VAR CurrentDate = MIN('BF Transition Status Confluence'[transition_date])
			VAR CurrentFromStatus = MIN('BF Transition Status Confluence'[to_status])
			
			RETURN
			CALCULATE(
			    MIN('BF Transition Status Confluence'[transition_date]),
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        'BF Transition Status Confluence'[issue_key] = CurrentKey
			        && 'BF Transition Status Confluence'[transition_date] > CurrentDate
			        && 'BF Transition Status Confluence'[from_status] = CurrentFromStatus
			        && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			    )
			)
