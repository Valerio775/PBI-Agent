	measure 'Destinazione Dinamica ToolTip BF Journey' = ```
			
			VAR _issueKeySelezionato = SELECTEDVALUE('Jira Business Feature'[Issue Key [Issue]]])
			
			VAR _statoDaIssue = 
			    IF(
			        NOT ISBLANK(_issueKeySelezionato),
			        CALCULATE(
			            SELECTEDVALUE('Jira Business Feature'[Status Tradotto]),
			            'Jira Business Feature'[Issue Key [Issue]]] = _issueKeySelezionato
			        )
			    )
			
			VAR _statoDaTabella = SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			
			VAR _statoCorrente = COALESCE(_statoDaTabella, _statoDaIssue)
			
			VAR _uatTestType = 
			    IF(
			        NOT ISBLANK(_issueKeySelezionato),
			        CALCULATE(
			            SELECTEDVALUE('Jira Business Feature'[Issue UAT Test Type]),
			            'Jira Business Feature'[Issue Key [Issue]]] = _issueKeySelezionato
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        _statoCorrente = "In Progress", "Drill-through Estimation Details FD",
			        _statoCorrente = "UAT" && _uatTestType = "Confluence OP-36", "Documento Comala UAT-TEST Confluence",
			        _statoCorrente = "UAT" && _uatTestType = "Xray Test Management", "Documento Comala XRAY"
			    )
			```
		lineageTag: 1628c1a9-4163-4ad1-8eba-e50a98af02f9

	measure '(gg) Transazione BF Journey' =
			
			VAR _Ingresso = 'BF Transition Status Confluence'[Data Ingresso Stato BF Journey]
			VAR _Uscita = 'BF Transition Status Confluence'[Data Uscita Stato BF Journey]
			RETURN
			    IF(
			        ISBLANK(_Ingresso),
			        BLANK(),
			        IF(
			            ISBLANK(_Uscita),
			            DATEDIFF(_Ingresso, NOW(), DAY),
			            DATEDIFF(_Ingresso, _Uscita, DAY)
			        )
			    )
