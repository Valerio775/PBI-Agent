table 'BF Transition Status Confluence'
	lineageTag: 4d6e20e5-46d5-4ee4-86fe-175ad5fe909d

	measure 'Data Ingresso BF Confluence' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Business Feature'[Issue key])
			VAR StatoCorrente = SELECTEDVALUE('Jira Business Feature'[Issue status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('BF Transition Status Confluence'[transition_date]),
			        FILTER(
			            ALL('BF Transition Status Confluence'),
			            'BF Transition Status Confluence'[issue_key] = IssueCorrente
			                && 'BF Transition Status Confluence'[to_status] = StatoCorrente
			                && 'BF Transition Status Confluence'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    LOOKUPVALUE(
			        'Jira Business Feature'[Issue created date],
			        'Jira Business Feature'[Issue key], IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open",
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Grafico 1
		lineageTag: 90d6cca3-87c9-4a42-9e08-86fe29facb3c

	measure 'Media per Stato BF Journey' =
			
			AVERAGEX(
			    VALUES('BF Transition Status Confluence'[issue_key]),
			    CALCULATE(MIN('BF Transition Status Confluence'[Giorni_In_Stato_Colonna Journey]))
			)
		displayFolder: Grafico 1
		lineageTag: 94b0fc7e-5371-4b56-8d30-5195cba1de7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Ingresso Stato BF Journey' =
			
			
			VAR issueKey = SELECTEDVALUE('BF Transition Status Confluence'[issue_key])
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			
			
			
			VAR StatiDellaFase =
			
			    CALCULATETABLE(
			
			        VALUES('Workflow Fasi BF Journey Confluence 2'[Status]),
			
			        FILTER(
			
			            ALL('Workflow Fasi BF Journey Confluence 2'),
			
			            'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = StatusTradotto
			
			        )
			
			    )
			
			VAR DataDaTransizioni =
			
			    CALCULATE(
			
			        MIN('BF Transition Status Confluence'[transition_date]),
			
			        FILTER(
			
			            ALL('BF Transition Status Confluence'),
			
			            'BF Transition Status Confluence'[issue_key] = issueKey
			
			                && 'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			
			                && NOT('BF Transition Status Confluence'[from_status] IN StatiDellaFase)
			
			                && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			
			        )
			
			    )
			
			RETURN
			    DataDaTransizioni
		formatString: General Date
		displayFolder: Grafico 2
		lineageTag: d300880a-f2f4-4e81-a8a4-488792bd2ee0

	measure 'Conteggio Pass-Through BF Journey' =
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey Confluence 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey Confluence 2'),
			            'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey Confluence 2'[Status], "Open")
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status Confluence'),
			                'BF Transition Status Confluence'[from_status] IN StatiDellaFase
			                    && NOT('BF Transition Status Confluence'[to_status] IN StatiDellaFase)
			                    && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			            ),
			            "iu_issue_key", 'BF Transition Status Confluence'[issue_key],
			            "iu_data", 'BF Transition Status Confluence'[transition_date]
			        )
			    )
			
			RETURN
			IF(
			    IsOpen,
			    COUNTROWS(
			        CALCULATETABLE(
			            VALUES('BF Transition Status Confluence'[issue_key]),
			            FILTER(
			                ALL('BF Transition Status Confluence'),
			                'BF Transition Status Confluence'[from_status] IN StatiDellaFase
			                && NOT('BF Transition Status Confluence'[to_status] IN StatiDellaFase)
			                && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			            )
			        )
			    ),
			    VAR TransizioniEntrata =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL('BF Transition Status Confluence'),
			                    'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			                ),
			                "ie_issue_key", 'BF Transition Status Confluence'[issue_key],
			                "ie_data", 'BF Transition Status Confluence'[transition_date]
			            )
			        )
			    VAR IssueUscite =
			        CALCULATETABLE(
			            VALUES('BF Transition Status Confluence'[issue_key]),
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES('BF Transition Status Confluence'[issue_key]),
			                    "HasCoppiaCompleta",
			                    VAR currentKey = 'BF Transition Status Confluence'[issue_key]
			                    VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = currentKey)
			                    VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = currentKey)
			                    RETURN
			                        COUNTROWS(
			                            FILTER(
			                                entrateIssue,
			                                VAR dataEntrata = [ie_data]
			                                RETURN
			                                    COUNTROWS(
			                                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                                    ) > 0
			                            )
			                        ) > 0
			                ),
			                [HasCoppiaCompleta] = TRUE()
			            )
			        )
			    RETURN
			    CALCULATE(
			        DISTINCTCOUNT('BF Transition Status Confluence'[issue_key]),
			        FILTER(
			            ALL('BF Transition Status Confluence'),
			            'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			            && 'BF Transition Status Confluence'[issue_key] IN IssueUscite
			        )
			    )
			)
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 9de83d14-9430-40cb-915a-d85ba10b5044

	measure 'Tempo Medio nello Stato BF Journey' = ```
			
			VAR StatusTradotto = 
			    SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey Confluence 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey Confluence 2'),
			            IF(
			                ISBLANK(StatusTradotto),
			                TRUE(),
			                'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = StatusTradotto
			            )
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey Confluence 2'[Status], "Open")
			
			VAR TransizioniEntrata =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status Confluence'),
			                'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			                && NOT('BF Transition Status Confluence'[from_status] IN StatiDellaFase)
			                && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			            ),
			            "ie_issue_key", 'BF Transition Status Confluence'[issue_key],
			            "ie_data", 'BF Transition Status Confluence'[transition_date]
			        )
			    )
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status Confluence'),
			                'BF Transition Status Confluence'[from_status] IN StatiDellaFase
			                && NOT('BF Transition Status Confluence'[to_status] IN StatiDellaFase)
			                && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			            ),
			            "iu_issue_key", 'BF Transition Status Confluence'[issue_key],
			            "iu_data", 'BF Transition Status Confluence'[transition_date]
			        )
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE(
			        VALUES('BF Transition Status Confluence'[issue_key]),
			        FILTER(
			            ALL('BF Transition Status Confluence'),
			            'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			            || 'BF Transition Status Confluence'[from_status] IN StatiDellaFase
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS(
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'BF Transition Status Confluence'[issue_key]
			        VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = issueKey)
			        VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = issueKey)
			        VAR sommaSoggiorni =
			            SUMX(
			                FILTER(
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN COUNTROWS(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                    ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata),
			                        [iu_data]
			                    )
			                RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			            )
			        RETURN 
			            IF(
			                ISBLANK(sommaSoggiorni) && IsOpen,
			                0,
			                IF(NOT ISBLANK(sommaSoggiorni), sommaSoggiorni, BLANK())
			            )
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(tabellaGiorni, NOT ISBLANK([giorni_totali])),
			    [giorni_totali]
			)
			```
		displayFolder: Grafico 2
		lineageTag: 65941cb2-672a-4d41-b44b-627e7c6d0bb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Uscita Stato BF Journey' = ```
			
