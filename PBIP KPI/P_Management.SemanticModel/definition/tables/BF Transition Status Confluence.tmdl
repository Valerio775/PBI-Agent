	measure 'Data Uscita Rework BF Journey' =
			
			VAR CurrentKey = MAX('BF Transition Status Confluence'[issue_key])
			VAR CurrentDate = MAX('BF Transition Status Confluence'[transition_date])
			VAR CurrentFromStatus = MAX('BF Transition Status Confluence'[from_status])
			
			RETURN
			CALCULATE(
			    MIN('BF Transition Status Confluence'[transition_date]),
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        'BF Transition Status Confluence'[issue_key] = CurrentKey
			        && 'BF Transition Status Confluence'[transition_date] > CurrentDate
			        && 'BF Transition Status Confluence'[to_status] = CurrentFromStatus
			        && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			    )
			)
		formatString: General Date
		displayFolder: Grafico 3
		lineageTag: 22e8998d-44b6-40e7-8104-7583e1c7e30f

	measure 'Conteggio Rework per Stato BF Journey' = ```
			
			VAR StatoCorrente = MAX('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			VAR OrdineCorrente = 
			    MAXX(
			        FILTER(
			            ALL('Workflow Fasi BF Journey Confluence 2'),
			            'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = StatoCorrente
			        ),
			        'Workflow Fasi BF Journey Confluence 2'[OrdineFase]
			    )
			
			RETURN
			COUNTROWS(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('BF Transition Status Confluence'),
			                VAR CurrentFromStatus = 'BF Transition Status Confluence'[from_status]
			                VAR CurrentToStatus = 'BF Transition Status Confluence'[to_status]
			                VAR CurrentKey = 'BF Transition Status Confluence'[issue_key]
			                VAR CurrentDate = 'BF Transition Status Confluence'[transition_date]
			
			                VAR OrdineFrom =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi BF Journey Confluence 2'),
			                            'Workflow Fasi BF Journey Confluence 2'[Status] = CurrentFromStatus),
			                        'Workflow Fasi BF Journey Confluence 2'[OrdineFase]
			                    )
			                VAR OrdineTo =
			                    MAXX(
			                        FILTER(ALL('Workflow Fasi BF Journey Confluence 2'),
			                            'Workflow Fasi BF Journey Confluence 2'[Status] = CurrentToStatus),
			                        'Workflow Fasi BF Journey Confluence 2'[OrdineFase]
			                    )
			
			                VAR DataUscita =
			                    CALCULATE(
			                        MIN('BF Transition Status Confluence'[transition_date]),
			                        FILTER(
			                            ALL('BF Transition Status Confluence'),
			                            'BF Transition Status Confluence'[issue_key] = CurrentKey
			                            && 'BF Transition Status Confluence'[transition_date] > CurrentDate
			                            && 'BF Transition Status Confluence'[to_status] = CurrentFromStatus
			                            && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			                        )
			                    )
			
			                RETURN
			                    NOT ISBLANK(OrdineFrom)
			                    && NOT ISBLANK(OrdineTo)
			                    && OrdineTo < OrdineFrom
			                    && OrdineFrom = OrdineCorrente
			                    && NOT ISBLANK(DataUscita)
			            ),
			            "issue_key", 'BF Transition Status Confluence'[issue_key]
			        )
			    )
			)
			```
		formatString: 0
		displayFolder: Grafico 3
		lineageTag: 2bae2273-c913-4397-8c42-2dd4d70b18c0

	measure 'Media Giorni Rework BF Journey' = ```
			
			VAR OrdineSelezionato = 
			    MAX('Workflow Fasi BF Journey Confluence 2'[OrdineFase])
			
			VAR TabellaFiltrata =
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        'BF Transition Status Confluence'[IsRework] = 1
			        && 'BF Transition Status Confluence'[OrdineFrom] = OrdineSelezionato
			    )
			
			RETURN
			IF(
			    ISBLANK(OrdineSelezionato),
			    BLANK(),
			    AVERAGEX(
			        TabellaFiltrata,
			        VAR DataIngresso = 'BF Transition Status Confluence'[transition_date]
			        VAR DataUscita = 
			            CALCULATE(
			                MIN('BF Transition Status Confluence'[transition_date]),
			                REMOVEFILTERS('Workflow Fasi BF Journey Confluence 2'),
			                FILTER(
			                    ALL('BF Transition Status Confluence'),
			                    'BF Transition Status Confluence'[issue_key] = EARLIER('BF Transition Status Confluence'[issue_key])
			                    && 'BF Transition Status Confluence'[transition_date] > EARLIER('BF Transition Status Confluence'[transition_date])
			                    && 'BF Transition Status Confluence'[to_status] = EARLIER('BF Transition Status Confluence'[from_status])
			                    && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			                )
			            )
			        RETURN
			        IF(
			            ISBLANK(DataUscita),
			            BLANK(), 
			            DATEDIFF(DataIngresso, DataUscita, DAY)
			        )
			    )
			)
			```
		displayFolder: Grafico 3
		lineageTag: 37f3ec88-daf3-4624-823a-f928807af8b3

	measure 'Media Rework per Stato BF Journey' = ```
			
			VAR OrdineSelezionato = MAX('Workflow Fasi BF Journey Confluence 2'[OrdineFase])
			
			VAR RigheRework =
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        NOT ISBLANK('BF Transition Status Confluence'[OrdineFrom])
			        && NOT ISBLANK('BF Transition Status Confluence'[OrdineTo])
			        && 'BF Transition Status Confluence'[OrdineTo] < 'BF Transition Status Confluence'[OrdineFrom]
			        && NOT ISBLANK(OrdineSelezionato)
			        && 'BF Transition Status Confluence'[OrdineFrom] = OrdineSelezionato
			        && NOT ISBLANK(
			            CALCULATE(
			                MIN('BF Transition Status Confluence'[transition_date]),
			                FILTER(
			                    ALL('BF Transition Status Confluence'),
			                    'BF Transition Status Confluence'[issue_key] = EARLIER('BF Transition Status Confluence'[issue_key])
			                    && 'BF Transition Status Confluence'[transition_date] > EARLIER('BF Transition Status Confluence'[transition_date])
			                    && 'BF Transition Status Confluence'[to_status] = EARLIER('BF Transition Status Confluence'[from_status])
			                    && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			                )
			            )
			        )
			    )
			
			VAR TotaleEpisodi = COUNTROWS(RigheRework)
			
			VAR IssueDistinte = 
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(RigheRework, "issue_key", 'BF Transition Status Confluence'[issue_key])
			        )
			    )
			
			RETURN
			DIVIDE(TotaleEpisodi, IssueDistinte)
			```
		displayFolder: Grafico 3
		lineageTag: 4598cec2-fe39-4949-bfdf-d70b47cb2f4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtro Rework BF Journey' = ```
			
			VAR FaseSelezionata = 
			    CALCULATE(
			        SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto]),
			        ALLSELECTED('Workflow Fasi BF Journey Confluence 2')
			    )
			
			VAR OrdineSelezionato =
			    IF(
			        NOT ISBLANK(FaseSelezionata),
			        MAXX(
			            FILTER(ALL('Workflow Fasi BF Journey Confluence 2'),
			                'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = FaseSelezionata),
			            'Workflow Fasi BF Journey Confluence 2'[OrdineFase]
			        ),
			        BLANK()
			    )
			
			VAR OrdineFromRiga = MAX('BF Transition Status Confluence'[OrdineFrom])
			VAR OrdineToRiga = MAX('BF Transition Status Confluence'[OrdineTo])
			
			RETURN
			IF(
			    NOT ISBLANK(OrdineFromRiga)
			    && NOT ISBLANK(OrdineToRiga)
			    && OrdineToRiga < OrdineFromRiga
			    && (ISBLANK(OrdineSelezionato) || OrdineFromRiga = OrdineSelezionato),
			    1, 0
			)
			```
