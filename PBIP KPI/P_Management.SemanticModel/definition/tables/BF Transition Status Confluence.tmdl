	column 'Giorni in Stato BF Journey' = ```
			
			VAR issueKey = 'BF Transition Status Confluence'[issue_key]
			VAR currentStatus = 
			    LOOKUPVALUE(
			        'Jira Business Feature'[Issue status],
			        'Jira Business Feature'[Issue key], issueKey
			    )
			
			VAR startDate =
			    CALCULATE(
			        MIN('BF Transition Status Confluence'[transition_date]),
			        FILTER(
			            ALL('BF Transition Status Confluence'),
			            'BF Transition Status Confluence'[issue_key] = issueKey
			                && 'BF Transition Status Confluence'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen = 
			    LOOKUPVALUE(
			        'Jira Business Feature'[Issue created date],
			        'Jira Business Feature'[Issue key], issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open" && ISBLANK(startDate),
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDateFinale),
			    DATEDIFF(startDateFinale, TODAY(), DAY),
			    BLANK()
			)
			```
		formatString: 0
		displayFolder: Grafico 1
		lineageTag: b30b09c8-302c-4145-9bd3-dbfbc67744fe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Giorni_In_Stato_Colonna Journey' =
			
			VAR currentIssue = 'BF Transition Status Confluence'[issue_key]
			VAR currentStatus = 'BF Transition Status Confluence'[to_status]
			
			VAR startDate =
			    CALCULATE(
			        MIN('BF Transition Status Confluence'[transition_date]),
			        ALLEXCEPT('BF Transition Status Confluence', 'BF Transition Status Confluence'[issue_key], 'BF Transition Status Confluence'[to_status])
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(startDate),
			    DATEDIFF(startDate, TODAY(), DAY)
			)
		formatString: 0
		displayFolder: Grafico 1
		lineageTag: 36c0f4d5-ea6a-41fe-9b53-5cb98bcde384
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Somma dei tempi nello stato BF Journey' = ```
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi BF Journey Confluence 2'[Status Tradotto])
			VAR issueKey = SELECTEDVALUE('BF Transition Status Confluence'[issue_key])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi BF Journey Confluence 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi BF Journey Confluence 2'),
			            'Workflow Fasi BF Journey Confluence 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi BF Journey Confluence 2'[Status], "Open")
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Business Feature'[Issue created date]),
			        REMOVEFILTERS('Jira Business Feature'),
			        'Jira Business Feature'[Issue key] = issueKey
			    )
			
			VAR entrateIssue =
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        'BF Transition Status Confluence'[issue_key] = issueKey
			        && 'BF Transition Status Confluence'[to_status] IN StatiDellaFase
			        && NOT('BF Transition Status Confluence'[from_status] IN StatiDellaFase)
			        && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			    )
			
			VAR usciteIssue =
			    FILTER(
			        ALL('BF Transition Status Confluence'),
			        'BF Transition Status Confluence'[issue_key] = issueKey
			        && 'BF Transition Status Confluence'[from_status] IN StatiDellaFase
			        && NOT('BF Transition Status Confluence'[to_status] IN StatiDellaFase)
			        && 'BF Transition Status Confluence'[from_status] <> 'BF Transition Status Confluence'[to_status]
			    )
			
			VAR primaUscitaOpen =
			    MINX(usciteIssue, 'BF Transition Status Confluence'[transition_date])
			
			VAR giorniOpen =
			    VAR primaEntrata = 
			        IF(
			            NOT ISBLANK(DataCreazioneOpen) && DataCreazioneOpen <= primaUscitaOpen,
			            DataCreazioneOpen,
			            primaUscitaOpen
			        )
			    VAR primaSoggiorno =
			        IF(
			            NOT ISBLANK(primaEntrata) && NOT ISBLANK(primaUscitaOpen) && primaEntrata < primaUscitaOpen,
			            DATEDIFF(primaEntrata, primaUscitaOpen, DAY),
			            0
			        )
			    VAR soggiorniSuccessivi =
			        SUMX(
			            FILTER(
			                entrateIssue,
			                VAR dataEntrata = 'BF Transition Status Confluence'[transition_date]
			                RETURN COUNTROWS(
			                    FILTER(usciteIssue, 'BF Transition Status Confluence'[transition_date] > dataEntrata)
			                ) > 0
			            ),
			            VAR dataEntrata = 'BF Transition Status Confluence'[transition_date]
			            VAR primaUscitaSucc =
			                MINX(
			                    FILTER(usciteIssue, 'BF Transition Status Confluence'[transition_date] > dataEntrata),
			                    'BF Transition Status Confluence'[transition_date]
			                )
			            RETURN DATEDIFF(dataEntrata, primaUscitaSucc, DAY)
			        )
			    RETURN primaSoggiorno + soggiorniSuccessivi
			
			VAR giorniAltriStati =
			    SUMX(
			        FILTER(
			            entrateIssue,
			            VAR dataEntrata = 'BF Transition Status Confluence'[transition_date]
			            RETURN COUNTROWS(
			                FILTER(usciteIssue, 'BF Transition Status Confluence'[transition_date] > dataEntrata)
			            ) > 0
			        ),
			        VAR dataEntrata = 'BF Transition Status Confluence'[transition_date]
			        VAR primaUscita =
			            MINX(
			                FILTER(usciteIssue, 'BF Transition Status Confluence'[transition_date] > dataEntrata),
			                'BF Transition Status Confluence'[transition_date]
			            )
			        RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			    )
			
			RETURN
			IF(IsOpen, giorniOpen, giorniAltriStati)
			```
		formatString: 0
		displayFolder: Grafico 2
		lineageTag: 08f16f31-6cff-420a-8776-05a4cf6e2a85
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

