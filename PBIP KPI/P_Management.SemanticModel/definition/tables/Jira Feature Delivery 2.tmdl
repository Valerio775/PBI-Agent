table 'Jira Feature Delivery 2'
	lineageTag: 076f1b67-b19d-41ff-9b58-a1b5c61ffaad
	sourceLineageTag: 1cd9a61a-e205-4e15-bfda-11a784cee7fb

	measure 'Estimation Effort %' = ```
			
			VAR Stato_Issue = SELECTEDVALUE('Jira Feature Delivery 2'[Issue status]) 
			RETURN 
			SWITCH
			(
			    Stato_Issue,
			    "Open", 0.00,
			    "Rejected", 0.00,
			    "Waiting for Estimate", 0.05,
			    "Estimation Approval", 0.1,
			    "Estimation Done", 0.2,
			    "Authorized", 0.25,
			    "In Progress", [Estimation Effort | Status In Progress],
			    "Completed", 0.8,
			    "Ready for UAT", 0.85,
			    "UAT Passed", 0.9,
			    "Release Completed", 1.0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a5135dde-b389-45b5-a4a1-0df90c4713e1

		changedProperty = Name

		changedProperty = FormatString

	measure 'Estimation Effort | Status In Progress' = ```
			
			VAR _FullIssue = SELECTEDVALUE('Jira Feature Delivery 2'[Issue])
			VAR _SelectedIssue = 
			    IF(
			        ISBLANK(_FullIssue) || COUNTROWS(VALUES('Jira Feature Delivery 2'[Issue])) > 1,
			        BLANK(),  -- più valori in contesto, non calcolare
			        IF(
			            ISERROR(FIND(" ", _FullIssue)),
			            _FullIssue,
			            LEFT(_FullIssue, FIND(" ", _FullIssue) - 1)
			        )
			    )
			VAR _EpicKeys = 
			    SELECTCOLUMNS(
			        FILTER(ALL('Jira Epic'), 'Jira Epic'[feature_delivery] = _SelectedIssue),
			        "EpicKey", 'Jira Epic'[issue_key]
			    )
			VAR _FilteredStories =
			    FILTER(
			        ALL('Jira Issue Detail 3'),
			        'Jira Issue Detail 3'[issue_type_name] IN {"Story", "Task"}
			        && 'Jira Issue Detail 3'[epiclink] IN _EpicKeys
			    )
			VAR _Done = COUNTROWS(FILTER(_FilteredStories, 'Jira Issue Detail 3'[status_category] = "Done"))
			VAR _InProgress = COUNTROWS(FILTER(_FilteredStories, 'Jira Issue Detail 3'[status_category] = "In Progress"))
			VAR _ToDo = COUNTROWS(FILTER(_FilteredStories, 'Jira Issue Detail 3'[status_category] = "To Do"))
			VAR _Total = _Done + _InProgress + _ToDo
			VAR _KPI_Raw = DIVIDE((_Done * 1) + (_InProgress * 0.5) + (_ToDo * 0), _Total)
			RETURN
			    IF(
			        ISBLANK(_SelectedIssue),
			        BLANK(),
			        IF(
			            ISEMPTY(_EpicKeys) || _Total = 0,
			            0.26,
			            0.26 + (_KPI_Raw * 0.53)
			        )
			    )
			```
		lineageTag: 26220acb-244a-4abd-ac95-2dd1b60fc038

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tech Progress' =
			
			VAR _SelectedIssue = SELECTEDVALUE('Jira Feature Delivery 2'[Issue])
			
			RETURN
			IF(
			    NOT(ISBLANK(_SelectedIssue)),
			    -- Caso: issue selezionata → restituisce la % di quella riga
			    CALCULATE(
			        [Estimation Effort %],
			        'Jira Feature Delivery 2'[Issue] = _SelectedIssue
			    ),
			    -- Caso: nessuna selezione → media su tutte le issue
			    AVERAGEX(
			        ADDCOLUMNS(
			            ALL('Jira Feature Delivery 2'[Issue]),
			            "EffortValue",
			            CALCULATE([Estimation Effort %])
			        ),
			        [EffortValue]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e4bd069b-a67d-4ef7-8f11-cc5e505869f5

		changedProperty = Name

		changedProperty = FormatString

	measure 'Verifica Corrispondenza Epic' = ```
			
			VAR KeyCorrente = SELECTEDVALUE('Jira Feature Delivery 2'[Issue Epic Key])
			VAR Esiste = 
			    KeyCorrente IN SELECTCOLUMNS('Jira Epic', "Key", 'Jira Epic'[issue_key])
			RETURN
			IF(
			    ISBLANK(KeyCorrente), 
			    BLANK(), 
			    IF(Esiste, 1, -1)
			)
			```
		formatString: 0
		lineageTag: fd3190e5-697b-4e5b-b65c-6e9750db0b92

		changedProperty = Name

	measure 'Conteggio FD' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('Jira Feature Delivery 2'[Issue Key [Issue]]]),
			    FILTER(
			        'Jira Feature Delivery 2',
			        not ISBLANK('Jira Feature Delivery 2'[Issue status]) 
			        && not ISBLANK('Jira Feature Delivery 2'[Issue Key [Issue]]])),
			    'Jira Project List 2'[Project_Status] <> "Demo Project")
			
			
			```
		formatString: #,0
		lineageTag: cc898e05-58de-491b-80c9-d234e72ef3a1

		changedProperty = Name

		changedProperty = FormatString

	measure 'Conteggio FD in progress in su' = ```
			CALCULATE(COUNTROWS('Jira Feature Delivery 2'), 
			not ISBLANK('Jira Feature Delivery 2'[Issue Key [Issue]]]) && 
			'Jira Feature Delivery 2'[Issue status] in {"In Progress", "Ready for UAT", "Completed", "Release Completed", "UAT Passed"},
			        'Jira Feature Delivery'[Issue Initiative Type] = "Project",
			        'Jira Business Feature'[Projectrak Project Status] <> "Demo Project",
			        'Jira Epic'[feature_delivery] <> "",
			        'Jira Project List'[Project_Status] <> "Demo Project"
			    )
				
			```
		formatString: #,0
		lineageTag: 2280507f-bac3-4006-a5e1-0548c30597f1

		changedProperty = Name

		changedProperty = FormatString

