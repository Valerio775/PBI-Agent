	column created_date =
			
			IF(
			    YEAR('Jira Macro Business Initiative'[Issue created date]) < 2026,
			    DATE(1999,01,01),
			    DATE(
			        YEAR('Jira Macro Business Initiative'[Issue created date]),
			        MONTH('Jira Macro Business Initiative'[Issue created date]),
			        DAY('Jira Macro Business Initiative'[Issue created date])
			    )
