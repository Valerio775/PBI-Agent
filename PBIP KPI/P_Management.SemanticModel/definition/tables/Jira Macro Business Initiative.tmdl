	column 'Status Tradotto' =
			
			SWITCH(
			    'Jira Macro Business Initiative'[Issue status],
			    "Rejected",                          "Rejected",
			    "Open",                              "Conferma Perimetro",
			    "High-Level Functional Requirement", "Preparazione BR",
			    "Tech Evaluation",                   "HLD e stime",
			    "Estimation Done",                   "PJPlan e costi DE",
			    "Financial Evaluation",              "IC DE Check e Markup",
			    "IM Management",                     "IC DE Check e Markup",
			    "Waiting for Approval",              "IC DE Check e Markup",
			    "WBE Management",                    "Approvazione P&C Applicant Unit",
			    "Approved",                          "IC DE approvazione e creazione Demand"
			)
		lineageTag: 9999a7ea-c3c3-4357-8115-dee22d9cd831
		summarizeBy: none

