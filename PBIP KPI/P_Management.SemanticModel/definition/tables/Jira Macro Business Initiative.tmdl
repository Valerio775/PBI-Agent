table 'Jira Macro Business Initiative'
	lineageTag: c454ebb4-02ef-457a-a812-3eccf98c7552
	sourceLineageTag: 0b05fb84-0cd9-4ca1-9ef4-e394079e17fc

	measure 'Data Ingresso Initial MBI' =
			
			var issue_key = SELECTEDVALUE('Jira Macro Business Initiative'[Issue key])
			RETURN
			CALCULATE(
			    MIN('MBI Transition Status'[transition_date]),
			    'MBI Transition Status'[to_status] = "High-Level Functional Requirement"
			)
		formatString: General Date
		lineageTag: 9f478810-f448-4a2b-b317-b4264e3fcd5b

		changedProperty = Name

	measure 'Data Ingresso Draft MBI' =
			
			CALCULATE(
			    MIN('Comala Activity MBI'[Date Convertita]),
			    'Comala Activity MBI'[Comala Stato Documento] = "In Draft"
			)
		formatString: General Date
		lineageTag: d0027789-08e3-4166-a4f4-9946c57eb274

		changedProperty = Name

	measure 'Data Ingresso Approved MBI' =
			
			CALCULATE(
			    MIN('Comala Activity MBI'[Date Convertita]),
			    'Comala Activity MBI'[Comala Stato Documento] = "Approved"
			)
		formatString: General Date
		lineageTag: 860e40ee-a272-43ac-9fc5-21041c8e24a8

		changedProperty = Name

	measure 'Data Stato Draft MBI (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Macro Business Initiative'[Issue key] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence MBI Pages',
			            "pageid", 'Confluence MBI Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] )
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "In Draft"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documenti confluence MBI
		lineageTag: 12d14594-727d-45ad-ac9c-b8021ea20ce1

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Data Stato Initial MBI (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Macro Business Initiative'[Issue key] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence MBI Pages',
			            "pageid", 'Confluence MBI Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] )
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Initial"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documenti confluence MBI
		lineageTag: 6a045b22-3419-4980-b97e-16f002f2e6d7

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Data Stato Approved MBI (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Macro Business Initiative'[Issue key] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence MBI Pages',
			            "pageid", 'Confluence MBI Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] )
			    )
			VAR _result =
			    CALCULATE (
			        MAX ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Approved"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documenti confluence MBI
		lineageTag: 1237a1f6-6134-40a3-b22d-802fa94ba484

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tempo di Preparazione MBI' =
			
			
			VAR dataInizital = [Data Stato Initial MBI (Confluence)]
			VAR dataDraft = [Data Stato Draft MBI (Confluence)]
			RETURN
			IF(
			    NOT ISBLANK(dataInizital) && NOT ISBLANK(dataDraft),
			    DATEDIFF(dataInizital, dataDraft, DAY)
			)
		formatString: 0
		displayFolder: Documenti confluence MBI
		lineageTag: 11905f50-9ce5-4413-97ae-2fbe0f0b2106

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tempo di Approvazione MBI' =
			
			
			VAR dataInizital = [Data Stato Initial MBI (Confluence)]
			VAR dataApproved = [Data Stato Approved MBI (Confluence)]
			RETURN
			IF(
			    NOT ISBLANK(dataInizital) && NOT ISBLANK(dataApproved),
			    DATEDIFF(dataInizital, dataApproved, DAY)
			)
		formatString: 0
		displayFolder: Documenti confluence MBI
		lineageTag: 3df23a68-22b0-4d12-bf8f-903cbbab6442

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tempo della Chiamata DU per HLD MBI' = ```
			
			
			VAR _dataInitialComala = [Data Stato Approved MBI (Confluence)]
			
			var _test = 
			CALCULATE(
			    MIN('MBI Transition Status'[transition_date]),
			    'MBI Transition Status'[to_status] = "Tech Evaluation"
			)
			
			RETURN
			
			    DATEDIFF(_test, _dataInitialComala, DAY)
			
			
			```
		formatString: 0
		displayFolder: Documenti confluence MBI
		lineageTag: 64050bf9-8382-451f-b1d1-e4005a1b60a7

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Media Tempo Fasi Documento MBI' = ```
			
			VAR T1 = [Tempo di Preparazione MBI]
			VAR T2 = [Tempo di Approvazione MBI]
			VAR T3 = [Tempo della Chiamata DU per HLD MBI]
			VAR Somma = 
			    COALESCE(T1, 0) + COALESCE(T2, 0) + COALESCE(T3, 0)
			VAR Conteggio = 
			    (IF(NOT ISBLANK(T1) && T1 <> 0, 1, 0)) 
			    + (IF(NOT ISBLANK(T2) && T2 <> 0, 1, 0)) 
			    + (IF(NOT ISBLANK(T3) && T3 <> 0, 1, 0))
			RETURN
			    IF(Conteggio > 0, DIVIDE(Somma, Conteggio))
			```
		displayFolder: Documenti confluence MBI
		lineageTag: d7bf87b5-c479-48d6-9412-c1a618b8f9c0

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Destinazione Dinamica 2' =
			
			VAR _statoCorrente = SELECTEDVALUE('Workflow Fasi MBI'[Status Tradotto])
			
			RETURN
			    SWITCH(
			        TRUE(),
			        _statoCorrente = "2. Preparazione BR", "Documenti confluence",
			        _statoCorrente = "HLD e stime", "Drill-through Estimation Details",
			        BLANK()
			    )
		lineageTag: 6856bfad-f933-4bbd-a141-e9a39c66c078

		changedProperty = Name

