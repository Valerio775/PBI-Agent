	measure 'Richiedente (visual)' =
			
			VAR _Richiedente =
			    SELECTEDVALUE ( 'Jira Demand'[1st richiedente] )
			RETURN
			IF (
			    ISBLANK ( _Richiedente ),
			    "Non esiste relazione tra Demand e BSN Need",
			    _Richiedente
			)
