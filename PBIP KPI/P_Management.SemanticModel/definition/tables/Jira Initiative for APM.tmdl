	column Check_Duplicati_IssueKey_JIFA =
			
			CALCULATE(
			    COUNTROWS('Jira Initiative for APM'),
			    ALLEXCEPT('Jira Initiative for APM', 'Jira Initiative for APM'[issue_key])
			)
		formatString: 0
		lineageTag: ea998e3f-c0df-4c9f-9769-c70af9bec4ec
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	partition 'Jira Initiative for APM' = entity
		mode: directQuery
		source
			entityName: Jira Initiative for APM
			expressionSource: 'DirectQuery in Analysis Services - SpringLab'

