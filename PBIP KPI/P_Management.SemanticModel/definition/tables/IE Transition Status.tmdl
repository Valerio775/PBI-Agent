	measure 'Filtro_Tabella_Dinamica IE' = ```
			
			VAR _End = [ToStatus_IE]
			
			-- Recuperiamo l'intervallo del mese selezionato nel report
			VAR _MinDate = MIN('IE Transition Status'[transition_date]) 
			VAR _MaxDate = MAX('IE Transition Status'[transition_date])
			
			RETURN
			IF( 
			    -- 1. Esiste la data di fine?
			    NOT ISBLANK(_End) 
			    
			    -- 2. La data di fine (Approved) è nel mese selezionato?
			    && _End >= _MinDate 
			    && _End <= _MaxDate, 
			    1, 
			    0 
			)
			```
		formatString: 0
		lineageTag: d0411489-48da-44c2-8744-384189872f70

	measure 'IE Data Ingresso' =
			
			VAR IssueCorrente = SELECTEDVALUE('Jira Initiative Estimation'[issue_key])
			VAR StatoCorrente = SELECTEDVALUE('Jira Initiative Estimation'[issue_status])
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MAX('IE Transition Status'[transition_date]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[issue_key] = IssueCorrente
			                && 'IE Transition Status'[to_status] = StatoCorrente
			                && 'IE Transition Status'[from_status] <> StatoCorrente
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Initiative Estimation'[issue_created_date]),
			        'Jira Initiative Estimation'[issue_key] = IssueCorrente
			    )
			
			RETURN
			IF(
			    StatoCorrente = "Open",// && ISBLANK(DataDaTransizioni),
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: OP34 MBI Journey
		lineageTag: a2da9600-972e-491c-806e-ebc361f60c1f

	measure 'IE conteggio giorni' =
			
			
			VAR issueKey = SELECTEDVALUE('Jira Initiative Estimation'[issue_key])
			VAR currentStatus = SELECTEDVALUE('Jira Initiative Estimation'[issue_status])
			
			VAR startDate =
			    CALCULATE(
			        MIN('IE Transition Status'[transition_date]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[issue_key] = issueKey
			                && 'IE Transition Status'[to_status] = currentStatus
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MAX('Jira Initiative Estimation'[issue_created_date]),
			        REMOVEFILTERS('Jira Initiative Estimation'),
			        'Jira Initiative Estimation'[issue_key] = issueKey
			    )
			
			VAR startDateFinale =
			    IF(
			        currentStatus = "Open",
			        DataCreazioneOpen,
			        startDate
			    )
			
			RETURN
			IF(
			    currentStatus = "Done",
			    0,
			    IF(
			        NOT ISBLANK(startDateFinale),
			        DATEDIFF(startDateFinale, TODAY(), DAY),
			        BLANK()
			    )
			)
		formatString: 0
		displayFolder: OP34 MBI Journey
		lineageTag: 7caae89e-92e3-44d1-8359-8d2089ae27f4

