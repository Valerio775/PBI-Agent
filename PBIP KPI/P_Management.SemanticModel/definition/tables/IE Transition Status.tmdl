	measure 'Roles IE' =
			
			VAR _username = SELECTEDVALUE('IE Transition Status'[username])
			VAR _projectKey = SELECTEDVALUE('MBI Transition Status'[project_key])
			RETURN
			CALCULATE(
			    CONCATENATEX(VALUES('Jira User Role'[role_name]), 'Jira User Role'[role_name], ", "),
			    'Jira User Role'[username] = _username,
			    'Jira User Role'[project_key] = _projectKey
			)
		lineageTag: efbd1cfe-1f33-4d3c-94ce-f6848b8e68c7

	measure 'IE Data Uscita' =
			
			VAR IssueCorrente = MAX('Jira Initiative Estimation'[issue_key])
			VAR StatoCorrente = MAX('Jira Initiative Estimation'[issue_status])
			
			VAR FaseCorrente =
			    LOOKUPVALUE(
			        'Workflow Fasi IE 2'[Status Tradotto],
			        'Workflow Fasi IE 2'[Status], StatoCorrente
			    )
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi IE 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi IE 2'),
			            'Workflow Fasi IE 2'[Status Tradotto] = FaseCorrente
			        )
			    )
			
			VAR DataIngresso = [IE Data Ingresso]
			
			RETURN
			CALCULATE(
			    MIN('IE Transition Status'[transition_date]),
			    FILTER(
			        ALL('IE Transition Status'),
			        'IE Transition Status'[issue_key] = IssueCorrente
			            && 'IE Transition Status'[transition_date] > DataIngresso
			            && 'IE Transition Status'[from_status] IN StatiDellaFase
			            && NOT('IE Transition Status'[to_status] IN StatiDellaFase)
			    )
			)
		formatString: General Date
		displayFolder: OP34 MBI Journey
		lineageTag: b1b8a5c9-e790-48a5-96c0-1806acd6b79e

	measure 'Data Ingresso Stato IE' =
			
			VAR issueKey = SELECTEDVALUE('IE Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi IE 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi IE 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi IE 2'),
			            'Workflow Fasi IE 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR DataCreazioneOpen =
			    CALCULATE(
			        MIN('Jira Initiative Estimation'[issue_start_date]),
			        REMOVEFILTERS('Jira Initiative Estimation'),
			        'Jira Initiative Estimation'[issue_key] = issueKey
			    )
			
			VAR DataDaTransizioni =
			    CALCULATE(
			        MIN('IE Transition Status'[transition_date]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[issue_key] = issueKey
			                && 'IE Transition Status'[to_status] IN StatiDellaFase
			                && NOT('IE Transition Status'[from_status] IN StatiDellaFase)
			                && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			        )
			    )
			
			RETURN
			IF(
			    StatusTradotto = "IE Open",
			    DataCreazioneOpen,
			    DataDaTransizioni
			)
		formatString: General Date
		displayFolder: Grafico Journey
		lineageTag: e566af8b-298c-44f2-bc80-09267e09278e

	measure 'Data Uscita Stato IE' =
			
			VAR issueKey = SELECTEDVALUE('IE Transition Status'[issue_key])
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi IE 2'[Status Tradotto])
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi IE 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi IE 2'),
			            'Workflow Fasi IE 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			RETURN
			CALCULATE(
			    MAX('IE Transition Status'[transition_date]),
			    REMOVEFILTERS('Workflow Fasi IE 2'),
			    FILTER(
			        ALL('IE Transition Status'),
			        'IE Transition Status'[issue_key] = issueKey
			            && 'IE Transition Status'[from_status] IN StatiDellaFase
			            && NOT('IE Transition Status'[to_status] IN StatiDellaFase)
			            && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			    )
			)
		formatString: General Date
		displayFolder: Grafico Journey
		lineageTag: 41a8489f-283b-4c07-a8d7-2387b93be496

	measure 'Conteggio Pass-Through IE' =
			
			VAR StatusTradotto = SELECTEDVALUE('Workflow Fasi IE 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi IE 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi IE 2'),
			            'Workflow Fasi IE 2'[Status Tradotto] = StatusTradotto
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi IE 2'[Status], "Open")
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('IE Transition Status'),
			                'IE Transition Status'[from_status] IN StatiDellaFase
			                    && NOT('IE Transition Status'[to_status] IN StatiDellaFase)
			                    && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'IE Transition Status'[issue_key],
			            "iu_data", 'IE Transition Status'[transition_date]
			        )
			    )
			
			RETURN
			IF(
			    IsOpen,
			    -- Per Open: conta tutte le issue che hanno almeno una transizione di uscita dalla fase
			    COUNTROWS(
			        CALCULATETABLE(
			            VALUES('IE Transition Status'[issue_key]),
			            FILTER(
			                ALL('IE Transition Status'),
			                'IE Transition Status'[from_status] IN StatiDellaFase
			                && NOT('IE Transition Status'[to_status] IN StatiDellaFase)
			                && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			            )
			        )
			    ),
			    -- Per tutti gli altri stati: logica originale con coppia completa
			    VAR TransizioniEntrata =
			        CALCULATETABLE(
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL('IE Transition Status'),
			                    'IE Transition Status'[to_status] IN StatiDellaFase
			                ),
			                "ie_issue_key", 'IE Transition Status'[issue_key],
			                "ie_data", 'IE Transition Status'[transition_date]
			            )
			        )
			    VAR IssueUscite =
			        CALCULATETABLE(
			            VALUES('IE Transition Status'[issue_key]),
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES('IE Transition Status'[issue_key]),
			                    "HasCoppiaCompleta",
			                    VAR currentKey = 'IE Transition Status'[issue_key]
			                    VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = currentKey)
			                    VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = currentKey)
			                    RETURN
			                        COUNTROWS(
			                            FILTER(
			                                entrateIssue,
			                                VAR dataEntrata = [ie_data]
			                                RETURN
			                                    COUNTROWS(
			                                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                                    ) > 0
			                            )
			                        ) > 0
			                ),
			                [HasCoppiaCompleta] = TRUE()
			            )
			        )
			    RETURN
			    CALCULATE(
			        DISTINCTCOUNT('IE Transition Status'[issue_key]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[to_status] IN StatiDellaFase
			            && 'IE Transition Status'[issue_key] IN IssueUscite
			        )
			    )
			)
		formatString: 0
		displayFolder: Grafico Journey
		lineageTag: 7b6fe9d7-192b-4268-98fd-5a58a83b50a6

	measure 'Tempo Medio nello Stato IE' = ```
			
			VAR StatusTradotto = 
			    SELECTEDVALUE('Workflow Fasi IE 2'[Status Tradotto])
			
			VAR StatiDellaFase =
			    CALCULATETABLE(
			        VALUES('Workflow Fasi IE 2'[Status]),
			        FILTER(
			            ALL('Workflow Fasi IE 2'),
			            IF(
			                ISBLANK(StatusTradotto),
			                TRUE(),
			                'Workflow Fasi IE 2'[Status Tradotto] = StatusTradotto
			            )
			        )
			    )
			
			VAR IsOpen = CONTAINS(StatiDellaFase, 'Workflow Fasi IE 2'[Status], "Open")
			
			VAR TransizioniEntrata =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('IE Transition Status'),
			                'IE Transition Status'[to_status] IN StatiDellaFase
			                && NOT('IE Transition Status'[from_status] IN StatiDellaFase)
			                && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			            ),
			            "ie_issue_key", 'IE Transition Status'[issue_key],
			            "ie_data", 'IE Transition Status'[transition_date]
			        )
			    )
			
			VAR TransizioniUscita =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                ALL('IE Transition Status'),
			                'IE Transition Status'[from_status] IN StatiDellaFase
			                && NOT('IE Transition Status'[to_status] IN StatiDellaFase)
			                && 'IE Transition Status'[from_status] <> 'IE Transition Status'[to_status]
			            ),
			            "iu_issue_key", 'IE Transition Status'[issue_key],
			            "iu_data", 'IE Transition Status'[transition_date]
			        )
			    )
			
			VAR IssueConSoggiorni =
			    CALCULATETABLE(
			        VALUES('IE Transition Status'[issue_key]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[to_status] IN StatiDellaFase
			            || 'IE Transition Status'[from_status] IN StatiDellaFase
			        )
			    )
			
			VAR tabellaGiorni =
			    ADDCOLUMNS(
			        IssueConSoggiorni,
			        "giorni_totali",
			        VAR issueKey = 'IE Transition Status'[issue_key]
			        VAR entrateIssue = FILTER(TransizioniEntrata, [ie_issue_key] = issueKey)
			        VAR usciteIssue  = FILTER(TransizioniUscita,  [iu_issue_key] = issueKey)
			        VAR sommaSoggiorni =
			            SUMX(
			                FILTER(
			                    entrateIssue,
			                    VAR dataEntrata = [ie_data]
			                    RETURN COUNTROWS(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata)
			                    ) > 0
			                ),
			                VAR dataEntrata = [ie_data]
			                VAR primaUscita =
			                    MINX(
			                        FILTER(usciteIssue, [iu_data] > dataEntrata),
			                        [iu_data]
			                    )
			                RETURN DATEDIFF(dataEntrata, primaUscita, DAY)
			            )
			        RETURN 
			            IF(
			                ISBLANK(sommaSoggiorni) && IsOpen,
			                0,
			                IF(NOT ISBLANK(sommaSoggiorni), sommaSoggiorni, BLANK())
			            )
			    )
			
			RETURN
			AVERAGEX(
			    FILTER(tabellaGiorni, NOT ISBLANK([giorni_totali])),
			    [giorni_totali]
			)
			```
		displayFolder: Grafico Journey
		lineageTag: 778871f3-e2a0-459d-8cbb-43182d9812ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

