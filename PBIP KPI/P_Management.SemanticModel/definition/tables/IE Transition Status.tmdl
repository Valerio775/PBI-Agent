	measure 'IE Tempo Storico Medio nello Stato Semplificato 2' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi IE Semplificate'[OrdineBarra] )
			
			RETURN
			CALCULATE (
			    VAR TransizioniEntrata =
			        SELECTCOLUMNS (
			            FILTER (
			                'IE Transition Status',
			                'IE Transition Status'[To OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'IE Transition Status'[From OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "ie_issue_key", 'IE Transition Status'[issue_key],
			            "ie_data", 'IE Transition Status'[transition_date]
			        )
			
			    VAR TransizioniUscita =
			        SELECTCOLUMNS (
			            FILTER (
			                'IE Transition Status',
			                'IE Transition Status'[From OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'IE Transition Status'[To OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "iu_issue_key", 'IE Transition Status'[issue_key],
			            "iu_data", 'IE Transition Status'[transition_date]
			        )
			
			    -- Una riga per OGNI singolo soggiorno (entrata->prima uscita), non aggregato per issue
			    VAR TabellaSoggiorni =
			        ADDCOLUMNS (
			            TransizioniEntrata,
			            "giorni_soggiorno",
			            VAR issueKey = [ie_issue_key]
			            VAR dataEntrata = [ie_data]
			            VAR usciteSuccessive =
			                FILTER (
			                    TransizioniUscita,
			                    [iu_issue_key] = issueKey && [iu_data] > dataEntrata
			                )
			            VAR primaUscita = MINX ( usciteSuccessive, [iu_data] )
			            RETURN
			                IF ( NOT ISBLANK ( primaUscita ), DATEDIFF ( dataEntrata, primaUscita, DAY ) )
			        )
			
			    RETURN
			    AVERAGEX (
			        FILTER ( TabellaSoggiorni, NOT ISBLANK ( [giorni_soggiorno] ) ),
			        [giorni_soggiorno]
			    ),
			    REMOVEFILTERS ( 'IE Transition Status' ),
			    REMOVEFILTERS ( 'Workflow Fasi IE' ),
			    REMOVEFILTERS ( 'Jira Initiative Estimation' ),
			    REMOVEFILTERS ( 'Workflow Fasi IE Semplificate 2' )
			)
		displayFolder: Focus HLD e Stime
		lineageTag: 3a53413e-5278-437b-9fbb-1f2421ef4598

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IE Aging Medio Corrente nello Stato Semplificato 2' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE (
			        'Workflow Fasi IE Semplificate 2'[OrdineBarra]
			    )
			
			VAR StatiDellaFase =
			    CALCULATETABLE (
			        VALUES ( 'Workflow Fasi IE Semplificate 2'[Status] ),
			        FILTER (
			            ALL ( 'Workflow Fasi IE Semplificate 2' ),
			            'Workflow Fasi IE Semplificate 2'[OrdineBarra]
			                = OrdineFaseCorrente
			        )
			    )
			
			VAR IssueAttualmenteInFase =
			    CALCULATETABLE (
			        VALUES ( 'Jira Initiative Estimation'[issue_key] ),
			        TREATAS (
			            StatiDellaFase,
			            'Jira Initiative Estimation'[issue_status]
			        )
			    )
			
			VAR TabellaAging =
			    ADDCOLUMNS (
			        IssueAttualmenteInFase,
			
			        "DataEntrataFase",
			
			        VAR CurrentIssue =
			            'Jira Initiative Estimation'[issue_key]
			
			        VAR UltimaEntrata =
			            CALCULATE (
			                MAX ( 'IE Transition Status'[transition_date] ),
			
			                FILTER (
			                    ALL ( 'IE Transition Status' ),
			                    'IE Transition Status'[issue_key] = CurrentIssue
			                        &&
			                    'IE Transition Status'[To OrdineBarra Semplificato]
			                        = OrdineFaseCorrente
			                        &&
			                    'IE Transition Status'[From OrdineBarra Semplificato]
			                        <> OrdineFaseCorrente
			                )
			            )
			
			        VAR CreatedDate =
			            CALCULATE (
			                MAX ( 'Jira Initiative Estimation'[created_date] )
			            )
			
			        RETURN
			            IF (
			                OrdineFaseCorrente = 1,
			                COALESCE ( UltimaEntrata, CreatedDate ),
			                UltimaEntrata
			            )
			    )
			
			RETURN
			AVERAGEX (
			    FILTER (
			        TabellaAging,
			        NOT ISBLANK ( [DataEntrataFase] )
			    ),
			    DATEDIFF (
			        [DataEntrataFase],
			        TODAY (),
			        DAY
			    )
			)
		displayFolder: Focus HLD e Stime
		lineageTag: 2ff179cc-1e97-4c19-97f6-851c6ae946b7

