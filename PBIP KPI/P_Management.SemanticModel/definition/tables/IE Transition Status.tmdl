	measure 'Conteggio Pass-Through Semplificato IE' =
			
			VAR IsSingleIssueSelected =
			    ISFILTERED('Jira Initiative Estimation'[issue_key])
			    &&
			    CALCULATE(
			        DISTINCTCOUNT('Jira Initiative Estimation'[issue_key]),
			        ALLSELECTED('Jira Initiative Estimation')
			    ) = 1
			VAR Risultato =
			    CALCULATE(
			        DISTINCTCOUNT('IE Transition Status'[issue_key]),
			        FILTER(
			            ALL('IE Transition Status'),
			            'IE Transition Status'[From OrdineBarra Semplificato]
			                = SELECTEDVALUE('Workflow Fasi IE Semplificate'[OrdineBarra])
			            &&
			            'IE Transition Status'[To OrdineBarra Semplificato]
			                <> SELECTEDVALUE('Workflow Fasi IE Semplificate'[OrdineBarra])
			        )
			    )
			RETURN
			    IF(
			        IsSingleIssueSelected && Risultato > 1,
			        BLANK(),
			        Risultato
			    )
		displayFolder: Focus HLD e Stime
		lineageTag: b1a3ce86-065c-4f13-a581-6c2dacce8fd6

	measure 'COUNT Backlog Semplificato IE' =
			
			VAR StatiDellaFase =
			    VALUES (
			        'Workflow Fasi IE Semplificate 2'[Status]
			    )
			
			RETURN
			CALCULATE (
			    DISTINCTCOUNT (
			        'Jira Initiative Estimation'[issue_key]
			    ),
			    TREATAS (
			        StatiDellaFase,
			        'Jira Initiative Estimation'[issue_status]
