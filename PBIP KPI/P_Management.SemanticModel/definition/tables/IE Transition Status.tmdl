	measure 'IE Tempo Storico Medio nello Stato Semplificato' =
			
			VAR OrdineFaseCorrente =
			    SELECTEDVALUE ( 'Workflow Fasi IE Semplificate'[OrdineBarra] )
			
			RETURN
			CALCULATE (
			    VAR TransizioniEntrata =
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'IE Transition Status' ),
			                'IE Transition Status'[To OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'IE Transition Status'[From OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "ie_issue_key", 'IE Transition Status'[issue_key],
			            "ie_data", 'IE Transition Status'[transition_date]
			        )
			
			    VAR TransizioniUscita =
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'IE Transition Status' ),
			                'IE Transition Status'[From OrdineBarra Semplificato] = OrdineFaseCorrente
			                    && 'IE Transition Status'[To OrdineBarra Semplificato] <> OrdineFaseCorrente
			            ),
			            "iu_issue_key", 'IE Transition Status'[issue_key],
			            "iu_data", 'IE Transition Status'[transition_date]
			        )
			
			    VAR TabellaSoggiorni =
			        ADDCOLUMNS (
			            TransizioniEntrata,
			            "giorni_soggiorno",
			            VAR issueKey = [ie_issue_key]
			            VAR dataEntrata = [ie_data]
			            VAR usciteSuccessive =
			                FILTER (
			                    TransizioniUscita,
			                    [iu_issue_key] = issueKey && [iu_data] > dataEntrata
			                )
			            VAR primaUscita = MINX ( usciteSuccessive, [iu_data] )
			            RETURN
			                IF ( NOT ISBLANK ( primaUscita ), DATEDIFF ( dataEntrata, primaUscita, DAY ) )
			        )
			
			    RETURN
			    AVERAGEX (
			        FILTER ( TabellaSoggiorni, NOT ISBLANK ( [giorni_soggiorno] ) ),
			        [giorni_soggiorno]
			    ),
			    ALL ()
			)
		displayFolder: Focus HLD e Stime
		lineageTag: 8c2237f8-e826-460a-8b63-2603781ff7b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Stato Initial IE (Confluence) 2' = ```
			
