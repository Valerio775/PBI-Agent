table 'Jira Feature Delivery'
	lineageTag: 007cc176-a60a-4b67-b347-13f73e6ef95d
	sourceLineageTag: 1cd9a61a-e205-4e15-bfda-11a784cee7fb

	measure 'Data Stato Draft (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Feature Delivery'[Issue Key [Issue]]] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence FD Pages',
			            "pageid", 'Confluence FD Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] ),
			        'Confluence Comala Issue Link'[confluence_labels] = "change_solution;demand_business_approval"
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "In Draft"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documento Comala
		lineageTag: 5bd300ad-66ff-49d3-9a3e-9c27d841f527

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Debug Context' =
			
			"PageID righe: " & COUNTROWS ( VALUES ( 'Confluence Comala Activity'[page_id] ) ) &
			" | Valori: " & CONCATENATEX ( VALUES ( 'Confluence Comala Activity'[page_id] ), 'Confluence Comala Activity'[page_id], ", " )
		lineageTag: 49a11623-70ba-4447-ad03-9c8b502362ff

		changedProperty = Name

	measure 'Data Stato Approved (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Feature Delivery'[Issue Key [Issue]]] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence FD Pages',
			            "pageid", 'Confluence FD Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] ),
			        'Confluence Comala Issue Link'[confluence_labels] = "change_solution;demand_business_approval"
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Approved"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documento Comala
		lineageTag: f4ba7587-6707-4615-b06f-92792210c94c

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Data Stato Initial (Confluence)' =
			
			VAR _issueKeys =
			    VALUES ( 'Jira Feature Delivery'[Issue Key [Issue]]] )
			VAR _pageIDs =
			    CALCULATETABLE (
			        SELECTCOLUMNS (
			            'Confluence FD Pages',
			            "pageid", 'Confluence FD Pages'[pageid]
			        ),
			        TREATAS ( _issueKeys, 'Confluence Comala Issue Link'[issue_key] )
			    )
			VAR _result =
			    CALCULATE (
			        MIN ( 'Confluence Comala Activity'[Date Convertita] ),
			        TREATAS ( _pageIDs, 'Confluence Comala Activity'[page_id] ),
			        'Confluence Comala Activity'[Comala Stato Documento] = "Initial"
			    )
			RETURN
			    _result
		formatString: General Date
		displayFolder: Documento Comala
		lineageTag: 08c50770-f7ad-40b8-a8d0-b3e63d57a75b

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tempo di Preparazione FD' =
			
			
			VAR dataInizital = [Data Stato Initial (Confluence)]
			VAR dataDraft = [Data Stato Draft (Confluence)]
			RETURN
			IF(
			    NOT ISBLANK(dataInizital) && NOT ISBLANK(dataDraft),
			    DATEDIFF(dataInizital, dataDraft, DAY)
			)
		formatString: 0
		displayFolder: Documento Comala
		lineageTag: 465f8d2d-285c-4cc1-80da-c8d3be7a10ee

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Tempo di Approvazione FD' =
			
			
			VAR dataInizital = [Data Stato Initial (Confluence)]
			VAR dataDraft = [Data Stato Approved (Confluence)]
			RETURN
			IF(
			    NOT ISBLANK(dataInizital) && NOT ISBLANK(dataDraft),
			    DATEDIFF(dataInizital, dataDraft, DAY)
			)
		formatString: 0
		displayFolder: Documento Comala
		lineageTag: e16f2773-2aa5-4bc5-9a74-0044b59beba3

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'tempo chiamata DU' = ```
			
			VAR _dataInitialComala = [Data Stato Approved (Confluence)]
			
			VAR _test = 
			    CALCULATE(
			        MIN('FD Transition Status Confluence'[transition_date]),
			        'FD Transition Status Confluence'[to_status] = "Completed"
			    )
			
			RETURN
			    ABS(DATEDIFF(_test, _dataInitialComala, DAY))
			```
		formatString: 0
		displayFolder: Documento Comala
		lineageTag: 856923f9-28a1-4863-b9e9-e2e9bde2ef61

		changedProperty = DisplayFolder

		changedProperty = Name

